// PROTOTYPE for #526 (docs/research/fight-plan-collapse/run.ts copies this into the pinned clone and removes it again). The
// #514 harness: it rebuilds the lag run's wave 25 (Rival Ivy against a party of six) and builds the overlay's battle card
// on it once per candidate way of collapsing the fight plan's ending pools, interleaved, recording what each card shows.
import { readFileSync, writeFileSync } from "node:fs";
import { timedEventManager } from "#app/global-event-manager";
import { BerryType } from "#enums/berry-type";
import { speciesDataRegistry } from "#app/global-species-data-registry";
import { MoveId } from "#enums/move-id";
import { SpeciesId } from "#enums/species-id";
import { PokemonMove } from "#moves/pokemon-move";
import { GameManager } from "#test/framework/game-manager";
import { afterAll, beforeAll, beforeEach, describe, it, vi } from "vitest";

const BUNDLE = process.env.COACH_BUNDLE as string;
const OUT = process.env.COACH_PROF_OUT as string;
const REPS = Number(process.env.COACH_REPS ?? 3);

// biome-ignore lint/suspicious/noExplicitAny: the HUD is plain page-world JS with no types here.
const g = globalThis as any;

// ---- the profiler the patched bundle calls
type Frame = { label: string; t0: number; child: number };
const prof = {
  stack: [] as Frame[],
  spans: new Map<string, { n: number; incl: number; excl: number }>(),
  counts: new Map<string, number>(),
  maxes: new Map<string, number>(),
  fightTurns: new Map<number, number>(),
  reset() {
    this.stack = [];
    this.spans = new Map();
    this.counts = new Map();
    this.maxes = new Map();
    this.fightTurns = new Map();
  },
  top() {
    return this.stack.at(-1)?.label ?? "-";
  },
  span<T>(label: string, fn: () => T, searchLike = false): T {
    if (searchLike) this.count(`searches:${label}`);
    const f: Frame = { label, t0: performance.now(), child: 0 };
    this.stack.push(f);
    try {
      return fn();
    } finally {
      const dt = performance.now() - f.t0;
      this.stack.pop();
      const parent = this.stack.at(-1);
      if (parent) parent.child += dt;
      const s = this.spans.get(label) ?? { n: 0, incl: 0, excl: 0 };
      s.n++;
      // A recursive span (game inside game) is counted once, at its outermost frame.
      if (!this.stack.some(x => x.label === label)) s.incl += dt;
      s.excl += dt - f.child;
      this.spans.set(label, s);
    }
  },
  game<T>(fn: () => T): T {
    return this.span("game", fn);
  },
  count(k: string, n = 1) {
    this.counts.set(k, (this.counts.get(k) ?? 0) + n);
  },
  max(k: string, v: number) {
    this.maxes.set(k, Math.max(this.maxes.get(k) ?? 0, v));
  },
  // tpFight: a memo hit is a call that left the memo the same size and had no `over`.
  fight<T>(fn: (...a: unknown[]) => T, a: unknown[]): T {
    const T = a[0] as { memo?: Map<string, unknown> };
    const before = T.memo?.size ?? 0;
    const t0 = performance.now();
    const r = fn(...a);
    const dt = performance.now() - t0;
    const where = this.top();
    this.count(`fight.calls:${where}`);
    if ((T.memo?.size ?? 0) > before || a[5]) {
      this.count(`fight.runs:${where}`);
      this.count(`fight.runMs:${where}`, dt);
    }
    return r;
  },
  fightEnd(turns: number, standing: number) {
    this.fightTurns.set(turns, (this.fightTurns.get(turns) ?? 0) + 1);
    if (standing > 0) this.count("fight.hitTurnCap");
  },
  merge<T>(fn: (...a: unknown[]) => T, a: unknown[]): T {
    const n = (a[0] as unknown[]).length;
    const k = a[1] as number;
    this.count("merge.calls");
    this.max("merge.maxIn", n);
    this.count(`merge.in≤${[4, 16, 64, 128, 256, 512].find(b => n <= b) ?? "more"}`);
    if (n > k) {
      this.count("merge.merging");
      let pairs = 0;
      for (let m = n; m > k; m--) pairs += (m * (m - 1)) / 2;
      this.count("merge.pairChecks", pairs);
    }
    const t0 = performance.now();
    const r = fn(...a);
    const dt = performance.now() - t0;
    this.count("merge.ms", dt);
    // k = 4: the turn loop's beam; k = 1: `one()`, an ending's pool collapsed to one branch.
    this.count(`merge.k${k}.calls`);
    this.count(`merge.k${k}.ms`, dt);
    this.max(`merge.k${k}.maxIn`, n);
    return r;
  },
  snapshot() {
    const r = (x: number) => Math.round(x * 10) / 10;
    return {
      spans: Object.fromEntries([...this.spans].map(([k, s]) => [k, { n: s.n, incl: r(s.incl), excl: r(s.excl) }])),
      counts: Object.fromEntries([...this.counts].map(([k, v]) => [k, r(v)])),
      maxes: Object.fromEntries(this.maxes),
      fightTurns: Object.fromEntries([...this.fightTurns].sort((a, b) => a[0] - b[0])),
    };
  },
};
g.__prof = prof;

// ---- #526: the candidates. Each card is built once per variant; `base` is today's code.
type Variant = { id: string; collapse: "base" | "exact" | "mode" | "heavy" | "bucket"; round?: number; prune?: number };
const ALL: Variant[] = [
  { id: "base", collapse: "base" },
  { id: "exact", collapse: "exact" },
  { id: "mode", collapse: "mode" },
  { id: "heavy", collapse: "heavy" },
  { id: "bucket", collapse: "bucket" },
  // Pruning: branches under this share of their pool's mass are left out of the collapse (not out of the odds).
  { id: "base+prune", collapse: "base", prune: 1e-3 },
  { id: "mode+prune", collapse: "mode", prune: 1e-3 },
  // Rounding: the memo keys HP in steps of this share of max HP instead of whole points. Today's whole points are
  // finer than 1% for any mon under 100 HP, so 1% is a finer key at wave 25, not a coarser one.
  { id: "exact+round3", collapse: "exact", round: 0.03 },
  { id: "mode+round1", collapse: "mode", round: 0.01 },
  { id: "mode+round3", collapse: "mode", round: 0.03 },
  { id: "mode+round5", collapse: "mode", round: 0.05 },
];
const VARIANTS = process.env.COACH_VARIANTS
  ? ALL.filter(v => (process.env.COACH_VARIANTS as string).split(",").includes(v.id))
  : ALL;
const CONT = ["mh", "fh", "ox", "od", "og", "fd", "fg"] as const;

// tpMergeNN2 from research/fight-plan-search-bench (make-copy.mjs): the same greedy closest-pair merge as `tpMerge`,
// same pair order, tie-break and arithmetic, in O(n^2).
let BUF = new Float64Array(1 << 16);
const mergeExact = (list: any[], k: number, T: any, mi: number, fi: number) => {
  const n = list.length;
  if (n <= k) return list.slice();
  if (BUF.length < n * n) BUF = new Float64Array(n * n * 2);
  const D = BUF;
  const om = T.ourMax[mi], fm = T.foeMax[fi];
  const P = new Float64Array(n), MH = new Float64Array(n), FH = new Float64Array(n), OX = new Float64Array(n), OD = new Float64Array(n), OG = new Float64Array(n), FD = new Float64Array(n), FG = new Float64Array(n);
  const TU: any[] = new Array(n), FS: any[] = new Array(n), MB: any[] = new Array(n), FB: any[] = new Array(n);
  const src = new Int32Array(n), merged = new Uint8Array(n), live = new Uint8Array(n).fill(1);
  for (let i = 0; i < n; i++) { const o = list[i]; P[i] = o.p; MH[i] = o.mh; FH[i] = o.fh; OX[i] = o.ox; OD[i] = o.od; OG[i] = o.og; FD[i] = o.fd; FG[i] = o.fg; TU[i] = o.turns; FS[i] = o.fs; MB[i] = o.mb; FB[i] = o.fb; src[i] = i; }
  const far = (i: number, j: number) => Math.abs(MH[i] - MH[j]) / om + Math.abs(FH[i] - FH[j]) / fm + (FS[i] !== FS[j] || MB[i] !== MB[j] || FB[i] !== FB[j] ? 1 : 0);
  const nn = new Int32Array(n).fill(-1), nd = new Float64Array(n).fill(Infinity);
  for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) { const d = far(i, j); D[i * n + j] = d; if (d < nd[i]) { nd[i] = d; nn[i] = j; } }
  const rescan = (i: number) => { let b = Infinity, bj = -1; const row = i * n; for (let j = i + 1; j < n; j++) if (live[j]) { const d = D[row + j]; if (d < b) { b = d; bj = j; } } nd[i] = b; nn[i] = bj; };
  let left = n;
  while (left > k) {
    let bi = -1, bd = Infinity;
    for (let i = 0; i < n; i++) if (live[i] && nn[i] >= 0 && nd[i] < bd) { bd = nd[i]; bi = i; }
    if (bi < 0) { const idx: number[] = []; for (let i = 0; i < n && idx.length < 2; i++) if (live[i]) idx.push(i); bi = idx[0]; nn[bi] = idx[1]; }
    const bj = nn[bi];
    const ap = P[bi], bp = P[bj], p = ap + bp;
    const w = (A: any) => (p > 0 ? (A[bi] * ap + A[bj] * bp) / p : A[bi]);
    const big = ap >= bp ? bi : bj;
    const tu = TU[bi] != null ? w(TU) : TU[big];
    const mh = w(MH), fh = w(FH), ox = w(OX), od = w(OD), og = w(OG), fd = w(FD), fg = w(FG);
    FS[bi] = FS[big]; MB[bi] = MB[big]; FB[bi] = FB[big]; src[bi] = src[big];
    P[bi] = p; MH[bi] = mh; FH[bi] = fh; OX[bi] = ox; OD[bi] = od; OG[bi] = og; FD[bi] = fd; FG[bi] = fg; TU[bi] = tu; merged[bi] = 1;
    live[bj] = 0; left--;
    for (let i = 0; i < bi; i++) if (live[i]) D[i * n + bi] = far(i, bi);
    for (let j = bi + 1; j < n; j++) if (live[j]) D[bi * n + j] = far(bi, j);
    rescan(bi);
    for (let i = 0; i < bi; i++) {
      if (!live[i]) continue;
      if (nn[i] === bi || nn[i] === bj) rescan(i);
      else { const d = D[i * n + bi]; if (d < nd[i] || (d === nd[i] && bi < nn[i])) { nd[i] = d; nn[i] = bi; } }
    }
    for (let i = bi + 1; i < bj; i++) if (live[i] && nn[i] === bj) rescan(i);
  }
  const res: any[] = [];
  for (let i = 0; i < n; i++) {
    if (!live[i]) continue;
    if (!merged[i]) { res.push(list[i]); continue; }
    const o: any = { ...list[src[i]], p: P[i], mh: MH[i], fh: FH[i], ox: OX[i], od: OD[i], og: OG[i], fd: FD[i], fg: FG[i] };
    if (TU[i] !== undefined || "turns" in list[src[i]]) o.turns = TU[i];
    res.push(o);
  }
  return res;
};

// One pass: every continuous field's p-weighted mean, and the discrete fields (`fs`, `mb`, `fb`) of the heaviest
// combination (`mode`) or of the heaviest single branch (`heavy`). Ties go to the first seen.
const meanOf = (list: any[], disc: "mode" | "heavy") => {
  let p = 0, top: any = list[0];
  const s: any = { mh: 0, fh: 0, ox: 0, od: 0, og: 0, fd: 0, fg: 0 };
  const by = new Map<string, { m: number; b: any }>();
  for (const b of list) {
    p += b.p;
    for (const f of CONT) s[f] += b.p * b[f];
    if (b.p > top.p) top = b;
    if (disc === "mode") {
      const key = `${b.fs},${b.mb},${b.fb}`;
      const e = by.get(key);
      if (e) e.m += b.p; else by.set(key, { m: b.p, b });
    }
  }
  if (!(p > 0)) return { ...list[0], p };
  let d = top;
  if (disc === "mode") { let m = -1; for (const e of by.values()) if (e.m > m) { m = e.m; d = e.b; } }
  return { p, mh: s.mh / p, fh: s.fh / p, ox: s.ox / p, od: s.od / p, og: s.og / p, fd: s.fd / p, fg: s.fg / p, fs: d.fs, mb: d.mb, fb: d.fb };
};

// `bucket`: the ending pools are never lists. Each branch is folded in as it settles, into running p-weighted sums and a
// mass per discrete combination, so the collapse is a read. Same answer as `mode`, up to summation order.
const newAcc = () => ({ acc: true, length: 0, p: 0, t: 0, s: { mh: 0, fh: 0, ox: 0, od: 0, og: 0, fd: 0, fg: 0 } as any, by: new Map<string, { m: number; b: any }>() });

const V = {
  cfg: ALL[0] as Variant,
  ms: 0, calls: 0, maxPool: 0, kept: 0, seen: 0, mixed: 0,
  reset(v: Variant) { this.cfg = v; this.ms = 0; this.calls = 0; this.maxPool = 0; this.kept = 0; this.seen = 0; this.mixed = 0; },
  hp(hp: number, max: number) { const q = this.cfg.round; return q ? Math.round(hp / (max * q)) : Math.round(hp); },
  pool(): any { return this.cfg.collapse === "bucket" ? newAcc() : []; },
  add(pool: any, b: any) {
    if (!pool.acc) { pool.push(b); return; }
    pool.length++; pool.p += b.p; pool.t += b.p * b.turns;
    for (const f of CONT) pool.s[f] += b.p * b[f];
    const key = `${b.fs},${b.mb},${b.fb}`;
    const e = pool.by.get(key);
    if (e) e.m += b.p; else pool.by.set(key, { m: b.p, b });
  },
  mass(list: any) { return list.acc ? list.p : list.reduce((t: number, b: any) => t + b.p, 0); },
  turnsAt(list: any, turns: number) { return list.acc ? list.t : list.reduce((t: number, x: any) => t + x.p * (x.turns ?? turns), 0); },
  one(list: any, T: any, mi: number, fi: number, tpMerge: any) {
    const t0 = performance.now();
    try {
      this.calls++;
      this.maxPool = Math.max(this.maxPool, list.length);
      if (list.acc) {
        const p = list.p;
        let m = -1, d: any = null;
        for (const e of list.by.values()) if (e.m > m) { m = e.m; d = e.b; }
        if (!(p > 0)) return { ...d, p };
        const s = list.s;
        return { p, mh: s.mh / p, fh: s.fh / p, ox: s.ox / p, od: s.od / p, og: s.og / p, fd: s.fd / p, fg: s.fg / p, fs: d.fs, mb: d.mb, fb: d.fb };
      }
      const total = list.reduce((t: number, b: any) => t + b.p, 0);
      let pool = list;
      if (this.cfg.prune && list.length > 1) {
        const cut = this.cfg.prune * total;
        const kept = list.filter((b: any) => b.p >= cut);
        if (kept.length) pool = kept;
      }
      this.seen += list.length; this.kept += pool.length;
      // Pools whose branches disagree on the discrete fields: the only ones where the collapses can pick differently.
      if (new Set(pool.map((b: any) => `${b.fs},${b.mb},${b.fb}`)).size > 1) this.mixed++;
      const c = this.cfg.collapse;
      // `p` is always the whole pool's mass, so `turnsAt` and the odds read the same in every variant.
      const b = c === "exact" ? mergeExact(pool, 1, T, mi, fi)[0]
        : c === "base" ? tpMerge(pool, 1, T, mi, fi)[0]
        : meanOf(pool, c as "mode" | "heavy");
      return { ...b, p: total };
    } finally {
      this.ms += performance.now() - t0;
    }
  },
};
g.__V = V;

function loadHud() {
  if (g.__hud) return g.__hud;
  g.window = globalThis;
  // biome-ignore lint/security/noGlobalEval: the HUD ships as one injectable script; this is how a page loads it.
  (0, eval)(readFileSync(BUNDLE, "utf8"));
  g.__hud["04-game-tables"].setGameTables({ species: speciesDataRegistry, events: timedEventManager });
  return g.__hud;
}

// ---- wave 25 of the 2026-10-01T10-41-17-742Z lag run, as far as the log shows it: species, levels, and every move a
// card in that wave names. The log has no full sets, so the remaining slots are plausible fillers, and IVs and natures
// are the harness's normalised 31 / Hardy. Printed with the results.
type Mon = { sp: SpeciesId; lv: number; moves?: MoveId[] };
const OURS: Mon[] = [
  { sp: SpeciesId.LARVITAR, lv: 15, moves: [MoveId.ROCK_THROW, MoveId.ROCK_SLIDE, MoveId.BITE, MoveId.LEER] },
  { sp: SpeciesId.MACHOP, lv: 13, moves: [MoveId.FOCUS_PUNCH, MoveId.LOW_KICK, MoveId.LOW_SWEEP, MoveId.LEER] },
  { sp: SpeciesId.TAILLOW, lv: 10, moves: [MoveId.PECK, MoveId.QUICK_ATTACK, MoveId.GROWL, MoveId.FOCUS_ENERGY] },
  { sp: SpeciesId.GROWLITHE, lv: 11, moves: [MoveId.EMBER, MoveId.BITE, MoveId.LEER, MoveId.HOWL] },
  { sp: SpeciesId.SKWOVET, lv: 10, moves: [MoveId.TACKLE, MoveId.TAIL_WHIP, MoveId.BITE, MoveId.STUFF_CHEEKS] },
  { sp: SpeciesId.ROCKRUFF, lv: 10, moves: [MoveId.BITE, MoveId.TACKLE, MoveId.LEER, MoveId.ROCK_THROW] },
];
const TANGELA_HEALS = [MoveId.MEGA_DRAIN, MoveId.INGRAIN, MoveId.SLEEP_POWDER, MoveId.VINE_WHIP];
const TANGELA_PLAIN = [MoveId.VINE_WHIP, MoveId.BIND, MoveId.POISON_POWDER, MoveId.GROWTH];
const FOES: Mon[] = [
  { sp: SpeciesId.COMBUSKEN, lv: 18, moves: [MoveId.DOUBLE_KICK, MoveId.EMBER, MoveId.PECK, MoveId.FOCUS_ENERGY] },
  { sp: SpeciesId.WATTREL, lv: 17, moves: [MoveId.PLUCK, MoveId.SPARK, MoveId.QUICK_ATTACK, MoveId.GROWL] },
  { sp: SpeciesId.TANGELA, lv: 16, moves: TANGELA_HEALS },
];

const setMon = (p: any, m: Mon) => {
  if (p.level !== m.lv) {
    p.level = m.lv;
    p.calculateStats();
  }
  p.hp = p.getMaxHp();
  if (m.moves) p.moveset = m.moves.map(id => new PokemonMove(id));
};
const describeMon = (p: any) =>
  `${p.name} L${p.level} ${p.hp}/${p.getMaxHp()} [${p.moveset.map((m: any) => m.getName()).join(", ")}]${p.isOnField() ? " (field)" : ""}`;

const results: unknown[] = [];
// FNV-1a, to compare whole cards without keeping them.
const hash = (s: string) => {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 0x01000193);
  return (h >>> 0).toString(16);
};

describe("read stage, wave 25", () => {
  let phaserGame: Phaser.Game;
  let game: GameManager;

  beforeAll(() => {
    phaserGame = new Phaser.Game({ type: Phaser.HEADLESS });
  });
  beforeEach(() => {
    game = new GameManager(phaserGame);
  });
  afterAll(() => {
    writeFileSync(OUT, JSON.stringify(results, null, 1));
  });

  async function arrive(foes: Mon[], ours: Mon[] = OURS, berries = false) {
    game.override.startingWave(25).battleStyle("single");
    // #526: a Sitrus Berry on every mon, so the ending pools disagree on `mb` / `fb` and the collapses can differ there.
    if (berries) {
      game.override.startingHeldItems([{ name: "BERRY", type: BerryType.SITRUS, count: 1 }])
        .enemyHeldItems([{ name: "BERRY", type: BerryType.SITRUS, count: 1 }]);
    }
    const scene = game.scene as any;
    const orig = scene.addEnemyPokemon.bind(scene);
    let i = 0;
    vi.spyOn(scene, "addEnemyPokemon").mockImplementation((_sp: unknown, _lv: unknown, ...rest: unknown[]) => {
      const m = foes[i++ % foes.length];
      return orig(speciesDataRegistry.getSpecies(m.sp), m.lv, ...rest);
    });
    await (game.classicMode.startBattle as any)(...ours.map(m => m.sp));
    const party = scene.getPlayerParty();
    party.forEach((p: any, k: number) => setMon(p, ours[k]));
    scene.getEnemyParty().forEach((p: any, k: number) => setMon(p, foes[k]));
    return scene;
  }

  // One card per variant, built fresh (the overlay builds it once per new turn or faint), the variants interleaved
  // within each rep so warm-up favours none. What the card shows is taken from the last rep; every rep must agree.
  function measure(scene: any, name: string, note: Record<string, unknown> = {}, times = REPS) {
    const hud = loadHud();
    const account = hud["98-tick"].accountRead(scene);
    const out: Record<string, any> = {};
    for (let k = 0; k < times; k++) {
      for (const v of VARIANTS) {
        prof.reset();
        V.reset(v);
        (prof as any).team = null;
        const t0 = performance.now();
        const card = hud["25-turn"].readTurn(scene, (turn: any) => hud["60-card"].composeBattleCard(turn, account));
        const ms = performance.now() - t0;
        const snap = prof.snapshot();
        const team = (prof as any).team;
        const base = team?.at(null);
        const shown = {
          // The act line: per slot, who acts, with what, at whom.
          act: card?.field?.slots?.map((sl: any) => ({ name: sl.name, move: sl.move ?? null, target: sl.target === "both" ? "both" : sl.target?.name ?? null })) ?? null,
          actText: hud["60-card"].actSummary(card),
          result: card?.teamPlan?.result ?? null,
          win: card?.teamPlan?.win?.name ?? null,
          plan: card?.teamPlan ?? null,
          value: team?.value ?? null,
          baseResult: base?.result ?? null,
          steps: base?.steps?.map((x: any) => ({ mi: x.mi, fi: x.fi, entry: x.entry, hp: x.hp, foeHp: x.foeHp, turns: x.turns, odds: x.odds })) ?? null,
          sig: JSON.stringify(card),
        };
        const o = (out[v.id] ??= { ms: [], collapseMs: [], ...shown, sigs: new Set<string>() });
        o.ms.push(Math.round(ms * 10) / 10);
        o.collapseMs.push(Math.round(V.ms * 10) / 10);
        o.sigs.add(shown.sig);
        Object.assign(o, shown, {
          collapses: V.calls, mixedPools: V.mixed, maxPool: V.maxPool, pruneKept: V.seen ? V.kept / V.seen : null,
          teamPlannerMs: snap.spans.teamPlanner?.incl ?? null, gameMs: snap.spans.game?.incl ?? null,
          mergeK4Ms: snap.counts["merge.k4.ms"] ?? 0,
          actsEdge: [snap.counts["acts.edge.true"] ?? 0, snap.counts["acts.edge.false"] ?? 0], fightRuns: Object.entries(snap.counts).filter(([key]) => key.startsWith("fight.runs:")).reduce((t, [, n]) => t + (n as number), 0),
        });
      }
    }
    for (const o of Object.values(out)) {
      o.stable = o.sigs.size === 1;
      o.sigs = undefined;
      o.sig = String(o.sig.length) + ":" + hash(o.sig);
    }
    const row = {
      name,
      ...note,
      wave: scene.currentBattle.waveIndex,
      trainer: scene.currentBattle.trainer?.getName?.() ?? null,
      ours: scene.getPlayerParty().map(describeMon),
      foes: scene.getEnemyParty().map(describeMon),
      variants: out,
    };
    results.push(row);
    const med = (a: number[]) => [...a].sort((x, y) => x - y)[Math.floor(a.length / 2)];
    console.log(`PROF ${name}: ${Object.entries(out).map(([id, o]) => `${id} ${med(o.ms)}`).join(" · ")} ms · ${out.base?.actText}`);
    return row;
  }

  // Ours standing, from all six down to the lead alone: the bench is fainted from the back.
  const standing = (scene: any, n: number) => {
    scene.getPlayerParty().forEach((p: any, k: number) => {
      p.hp = k < n ? p.getMaxHp() : 0;
    });
  };

  it("Tangela with its heals: ours standing 6 → 1, all three foes up", async () => {
    const scene = await arrive(FOES);
    for (let n = 6; n >= 1; n--) {
      standing(scene, n);
      measure(scene, `heals · ours ${n} · foes 3`, { ours: n, foes: 3, tangela: "heals" });
    }
  });

  it("Tangela without heals: ours standing 6 → 3", async () => {
    const scene = await arrive([FOES[0], FOES[1], { ...FOES[2], moves: TANGELA_PLAIN }]);
    for (let n = 6; n >= 3; n--) {
      standing(scene, n);
      measure(scene, `plain · ours ${n} · foes 3`, { ours: n, foes: 3, tangela: "plain" });
    }
  });

  it("one foe down: six of ours against two", async () => {
    const scene = await arrive(FOES);
    for (const down of [2, 1]) {
      standing(scene, 6);
      scene.getEnemyParty().forEach((p: any, k: number) => {
        p.hp = k === down ? 0 : p.getMaxHp();
      });
      measure(scene, `heals · ours 6 · foes 2 (${FOES[down].sp === SpeciesId.TANGELA ? "Tangela" : "Wattrel"} down)`, { ours: 6, foes: 2, down });
    }
  });

  // The field's most common slow state: Tangela out, one of ours facing it. Machop leads, as at #13–#15.
  it("Tangela on the field against Machop: ours standing 6 → 3", async () => {
    const scene = await arrive([FOES[2], FOES[1], FOES[0]], [OURS[1], OURS[0], ...OURS.slice(2)]);
    for (let n = 6; n >= 3; n--) {
      standing(scene, n);
      measure(scene, `heals · Tangela out · ours ${n} · foes 3`, { ours: n, foes: 3, tangela: "heals", out: "Tangela" });
    }
  });

  // Mid-fight HP, as the field had it: the memo is keyed on HP, so the states a search walks differ with it.
  it("Tangela on the field, random mid-fight HP: 5 and 6 of ours", async () => {
    const scene = await arrive([FOES[2], FOES[1], FOES[0]], [OURS[1], OURS[0], ...OURS.slice(2)]);
    let seed = 514;
    const rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
    for (let k = 0; k < Number(process.env.COACH_RANDOM ?? 16); k++) {
      const n = k % 2 ? 5 : 6;
      scene.getPlayerParty().forEach((p: any, i: number) => {
        p.hp = i < n ? Math.max(1, Math.round(p.getMaxHp() * (0.15 + 0.85 * rnd()))) : 0;
      });
      scene.getEnemyParty().forEach((p: any) => {
        p.hp = Math.max(1, Math.round(p.getMaxHp() * (0.3 + 0.7 * rnd())));
      });
      measure(scene, `heals · Tangela out · random #${k} · ours ${n} · foes 3`, { ours: n, foes: 3, tangela: "heals", random: k }, 1);
    }
  });

  // #526: the same random draws with Larvitar leading against Combusken, and with no healer at all (the control).
  const randomHp = (scene: any, k: number, rnd: () => number, foesDown = false) => {
    const n = [6, 5, 4][k % 3];
    scene.getPlayerParty().forEach((p: any, i: number) => {
      p.hp = i < n ? Math.max(1, Math.round(p.getMaxHp() * (0.15 + 0.85 * rnd()))) : 0;
    });
    scene.getEnemyParty().forEach((p: any, i: number) => {
      p.hp = foesDown && i > 0 && rnd() < 0.3 ? 0 : Math.max(1, Math.round(p.getMaxHp() * (0.3 + 0.7 * rnd())));
    });
    return n;
  };
  it("Combusken on the field against Larvitar, random mid-fight HP: heals", async () => {
    const scene = await arrive(FOES);
    let seed = 526;
    const rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
    for (let k = 0; k < Number(process.env.COACH_RANDOM2 ?? 8); k++) {
      const n = randomHp(scene, k, rnd, true);
      measure(scene, `heals · Combusken out · random #${k} · ours ${n}`, { ours: n, tangela: "heals", out: "Combusken", random: k }, 1);
    }
  });
  it("berries: a Sitrus Berry on every mon, Tangela with heals on the field", async () => {
    const scene = await arrive([FOES[2], FOES[1], FOES[0]], [OURS[1], OURS[0], ...OURS.slice(2)], true);
    for (let n = 6; n >= 3; n--) {
      standing(scene, n);
      measure(scene, `heals · berries · Tangela out · ours ${n} · foes 3`, { ours: n, foes: 3, tangela: "heals", berries: true });
    }
    let seed = 5261;
    const rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
    for (let k = 0; k < Number(process.env.COACH_RANDOM2 ?? 8); k++) {
      const n = randomHp(scene, k, rnd, true);
      measure(scene, `heals · berries · Tangela out · random #${k} · ours ${n}`, { ours: n, tangela: "heals", berries: true, random: k }, 1);
    }
  });
  it("control, no healer: Tangela without heals on the field, random mid-fight HP", async () => {
    const scene = await arrive([{ ...FOES[2], moves: TANGELA_PLAIN }, FOES[1], FOES[0]], [OURS[1], OURS[0], ...OURS.slice(2)]);
    let seed = 5260;
    const rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
    for (let k = 0; k < Number(process.env.COACH_RANDOM2 ?? 8); k++) {
      const n = randomHp(scene, k, rnd, true);
      measure(scene, `plain · Tangela out · random #${k} · ours ${n}`, { ours: n, tangela: "plain", out: "Tangela", random: k }, 1);
    }
  });
});
