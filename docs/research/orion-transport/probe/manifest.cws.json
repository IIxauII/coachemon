{
  "manifest_version": 3,
  "name": "Orion transport probe (#150) CWS",
  "version": "0.0.1",
  "description": "PROTOTYPE, throwaway: can a background reach a local process on 127.0.0.1 and relay commands into pokerogue.net?",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://pokerogue.net/*", "http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["https://pokerogue.net/*"], "js": ["main.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://pokerogue.net/*"], "js": ["isolated.js"], "run_at": "document_idle" }
  ]
}
