const DEADLINE_MS = 540_000;
const PORT = process.env.COACH_PORT;

// `GameManager`'s constructor swaps the prototype's for a max roll (#632).
const realRand = BattleScene.prototype.randBattleSeedInt;

// Commander's animations read a sprite frame the headless game never draws, and throw (game-code.md §35, #792).
const realAnim = BattleScene.prototype.triggerPokemonBattleAnim;
BattleScene.prototype.triggerPokemonBattleAnim = function (this: BattleScene, pokemon, type, ...rest) {
  if (type === PokemonAnimType.COMMANDER_APPLY || type === PokemonAnimType.COMMANDER_REMOVE) return true;
  return realAnim.call(this, pokemon, type, ...rest);
};

// The IV Scanner's phase picks its stat labels by a sprite name the headless game never keeps, and throws (game-code.md
// §36).
ScanIvsPhase.prototype.start = function (this: ScanIvsPhase) {
  this.end();
};
const OVERRIDES = [
  "IVS_OVERRIDE",
  "ENEMY_IVS_OVERRIDE",
  "NATURE_OVERRIDE",
  "ENEMY_NATURE_OVERRIDE",
  "SHINY_OVERRIDE",
  "ENEMY_SHINY_OVERRIDE",
] as const;

type PartySlot = { slot: number; species: string };
/** `forget` null declines the move. */
type LearnPick = PartySlot & { move: string; forget: string | null };
type Asked = { replacement?: PartySlot; learns?: LearnPick[]; pivots?: PartySlot[] };
type Target = { side: "foes" | "ours"; field: number };
type FieldCommand = { kind: "move"; move: string; tera: boolean; target?: Target } | { kind: "switch"; to: PartySlot };
type Replacement = PartySlot & { field: number };
type Input =
  | (({ kind: "move"; move: string; tera: boolean } | { kind: "switch"; to: PartySlot }) & Asked)
  | ({ kind: "queued" } & Asked)
  | {
      kind: "double";
      commands: (FieldCommand | null)[];
      replacements?: Replacement[];
      learns?: LearnPick[];
      pivots?: Replacement[];
    };
type Turn = "won" | "lost" | "on" | { illegal: string };

/**
 * `at`: a fork point to start from, for a save that isn't the wave's start (`src/solver/extras.ts`). `liveExport`: a
 * carried save's live export, migrated as a load migrates the save (#703).
 */
const job: { save: any; inputs: Input[]; at?: string; liveExport?: any } = JSON.parse(
  readFileSync(process.env.COACH_IN as string, "utf8"),
);
const report: Record<string, unknown> = {};

let phaserGame: Phaser.Game;
let game: GameManager;
let boots = 0;
const scene = () => game.scene as any;
const species = (p: any): string => SpeciesId[p.species.speciesId];

const mon = (p: any, slot: number) => ({
  slot,
  species: species(p),
  onField: p.isOnField(),
  hp: p.hp,
  maxHp: p.getMaxHp(),
  status: StatusEffect[p.status?.effect ?? StatusEffect.NONE],
  statStages: [...p.getStatStages()],
  tera: p.isTerastallized,
  // Index 0 is the last bar (game-code.md §3).
  ...(p.isBoss() && { bossBars: p.isFainted() ? 0 : p.bossSegmentIndex + 1 }),
});
const checkpoint = () => ({ ours: scene().getPlayerParty().map(mon), foes: scene().getEnemyParty().map(mon) });

function stackTotals(items: any[]): Record<string, number> {
  const out: Record<string, number> = {};
  for (const item of items) out[item.type.id] = (out[item.type.id] ?? 0) + item.stackCount;
  return out;
}

function unlikeTheSave(side: string, mons: any[], saved: any[]): string[] {
  return mons.flatMap((p, i) =>
    [
      JSON.stringify(p.ivs) !== JSON.stringify(saved[i]?.ivs) && "IVs",
      p.nature !== saved[i]?.nature && "nature",
      p.shiny !== saved[i]?.shiny && "shininess",
    ]
      .filter(Boolean)
      .map(what => `${side} ${species(p)}'s ${what}`),
  );
}

// Mirrors `CommandPhase.tryExecuteQueuedMove`: true when the turn runs a queued move (a two-turn move's second turn, a
// rampage, a recharge) without asking for a command.
function queuedRuns(active: any): boolean {
  const moveset: any[] = active.getMoveset();
  const next = active
    .getMoveQueue()
    .find(
      (q: any) =>
        q.move === MoveId.NONE ||
        isVirtual(q.useMode) ||
        (moveset.find(m => m.moveId === q.move)?.isUsable(active, isIgnorePP(q.useMode), true)?.[0] ?? false),
    );
  return next !== undefined && (next.move === MoveId.NONE || isVirtual(next.useMode) || moveset.some(m => m.moveId === next.move));
}

const double = (): boolean => scene().currentBattle.double;

/** Mirrors `CommandPhase.checkCommander`: a mon inside its ally is asked for nothing (game-code.md §35). */
const commanding = (p: any): boolean => double() && p.getAlly()?.getTag(BattlerTagType.COMMANDED)?.getSourcePokemon() === p;

/**
 * By field slot: whether the turn asks that slot for a command, which one on the field playing no queued move and
 * commanding no ally is.
 */
const fieldAsked = (): boolean[] =>
  scene().getPlayerField().map((p: any) => p.isActive(true) && !queuedRuns(p) && !commanding(p));

const asksCommand = () => fieldAsked().some(Boolean);

/**
 * The battler indices a single-target move makes us choose between, empty where the game picks (game-code.md §25). A
 * random target is drawn from the battle stream as it is asked, so it is never asked here.
 */
function choices(active: any, move: MoveId): number[] {
  if (allMoves[move].moveTarget === MoveTarget.RANDOM_NEAR_ENEMY) return [];
  const { targets, multiple } = getMoveTargets(active, move);
  return targets.length > 1 && !multiple ? targets : [];
}

/** A lone foe goes unnamed: `issue` aims at it (#794). */
function targetsOf(active: any, move: string): (Target | undefined)[] {
  if (!double()) return [undefined];
  const all = choices(active, MoveId[move as keyof typeof MoveId]);
  if (all.length === 0) return [undefined];
  const foes = all.filter(t => t >= BattlerIndex.ENEMY);
  const ours: Target[] = all.filter(t => t < BattlerIndex.ENEMY).map(field => ({ side: "ours", field }));
  const named: Target[] = foes.map(t => ({ side: "foes", field: t - BattlerIndex.ENEMY }));
  return [...(foes.length === 1 ? [undefined] : named), ...ours];
}

function commandsOf(active: any): FieldCommand[] {
  const usable = active.getMoveset().filter((m: any) => m.isUsable(active, false, true)[0]);
  // With nothing usable, the fight command plays Struggle (`CommandPhase.handleFightCommand`).
  const moves: string[] = usable.length > 0 ? usable.map((m: any) => MoveId[m.moveId]) : ["STRUGGLE"];
  const tera = canTerastallize(active);
  const out: FieldCommand[] = moves.flatMap(move =>
    targetsOf(active, move).flatMap(target => [
      { kind: "move" as const, move, tera: false, ...(target && { target }) },
      ...(tera ? [{ kind: "move" as const, move, tera: true, ...(target && { target }) }] : []),
    ]),
  );
  if (!active.isTrapped()) {
    scene()
      .getPlayerParty()
      .forEach((p: any, slot: number) => {
        if (!p.isFainted() && !p.isOnField()) out.push({ kind: "switch", to: { slot, species: species(p) } });
      });
  }
  return out;
}

/** In a double, one command per field slot asked, never both switching to one mon nor both terastallizing (#788). */
function legal(): Input[] {
  const field = scene().getPlayerField();
  if (!double()) return commandsOf(field[0]);
  const [first, second] = fieldAsked().map((ask, i) => (ask ? commandsOf(field[i]) : [null]));
  const out: Input[] = [];
  for (const a of first) {
    for (const b of second ?? [null]) {
      if (a?.kind === "switch" && b?.kind === "switch" && a.to.slot === b.to.slot) continue;
      if (a?.kind === "move" && b?.kind === "move" && a.tera && b.tera) continue;
      out.push({ kind: "double", commands: [a, b] });
    }
  }
  return out;
}

const sameCommand = (a: FieldCommand | null, b: FieldCommand | null): boolean =>
  a === null || b === null
    ? a === b
    : a.kind === "move"
      ? b.kind === "move" && a.move === b.move && a.tera === b.tera && a.target?.side === b.target?.side && a.target?.field === b.target?.field
      : b.kind === "switch" && a.to.slot === b.to.slot && a.to.species === b.to.species;

const same = (a: Input, b: Input) =>
  a.kind === "double"
    ? b.kind === "double" && sameCommand(a.commands[0], b.commands[0]) && sameCommand(a.commands[1] ?? null, b.commands[1] ?? null)
    : a.kind !== "queued" && b.kind !== "queued" && b.kind !== "double" && sameCommand(a, b);

/** A turn the game plays for us, with no command of ours in it. */
const isQueued = (input: Input | null | undefined): input is Input =>
  input?.kind === "queued" || (input?.kind === "double" && input.commands.every(c => c === null));

const replacementsOf = (input: Input | null): (PartySlot | Replacement)[] =>
  input === null ? [] : input.kind === "double" ? (input.replacements ?? []) : input.replacement ? [input.replacement] : [];

const pivotsOf = (input: Input | null): (PartySlot | Replacement)[] => input?.pivots ?? [];

// A prompt left queued for a decision the game never asks for is taken by the next one, and every later input lands a
// turn late (#632).
function strayPrompts(): number {
  const prompts: unknown[] = (game.promptHandler as any).prompts;
  const stray = prompts.length;
  prompts.length = 0;
  return stray;
}

/** Queued in field order: each prompt goes to the next command screen the game shows (#788). */
function command(input: Input | null) {
  if (input === null || input.kind === "queued") return;
  if (input.kind === "double") return input.commands.forEach((c, field) => c && issue(c, field));
  issue(input, 0);
}

function issue(input: FieldCommand, field: number) {
  if (input.kind === "switch") return game.doSwitchPokemon(input.to.slot);
  const move = MoveId[input.move as keyof typeof MoveId];
  if (move !== MoveId.STRUGGLE) {
    if (!double()) return input.tera ? game.move.selectWithTera(move) : game.move.select(move);
    const { target } = input;
    const named = target && (target.side === "foes" ? BattlerIndex.ENEMY + target.field : target.field);
    const at = named ?? choices(scene().getPlayerField()[field], move).find(t => t >= BattlerIndex.ENEMY);
    return input.tera ? game.move.selectWithTera(move, field, at) : game.move.select(move, field, at);
  }
  // The move helper refuses a move with no PP left, so this sends what the menu would.
  game.onNextPrompt("CommandPhase", UiMode.COMMAND, () => {
    scene().ui.setMode(UiMode.FIGHT, (scene().phaseManager.getCurrentPhase() as CommandPhase).getFieldIndex());
  });
  game.onNextPrompt("CommandPhase", UiMode.FIGHT, () => {
    const phase = scene().phaseManager.getCurrentPhase() as CommandPhase;
    phase.handleCommand(input.tera ? Command.TERA : Command.FIGHT, 0, MoveUseMode.NORMAL);
  });
}

/** A level-up's prompt to forget a move for a new one: the mon, the move, and the moves it knows (game-code.md §17). */
type Learning = PartySlot & { move: string; knows: string[] };

const declined = ({ knows: _knows, ...asked }: Learning): LearnPick => ({ ...asked, forget: null });

const fits = (pick: LearnPick, asked: Learning) =>
  pick.slot === asked.slot &&
  pick.species === asked.species &&
  pick.move === asked.move &&
  (pick.forget === null || asked.knows.includes(pick.forget));

/**
 * Answers each learn prompt as it comes, as upstream's own learn-move test does: yes to forgetting a move, then the move
 * on the summary screen, where the new move's own slot declines (game-code.md §17). A pick missing or not fitting
 * declines, so the turn can end, and is the turn's illegal step.
 */
function learning(pick: (asked: Learning, i: number) => LearnPick | undefined) {
  const picked: LearnPick[] = [];
  let illegal: string | undefined;
  let answering: { phase: unknown; cursor: number; stage: "summary" | "stop" | "done" } | undefined;
  const watch = setInterval(() => {
    const phase: any = scene().phaseManager.getCurrentPhase();
    const ui = scene().ui;
    if (!phase?.is("LearnMovePhase") || !ui.getHandler()?.active) return;
    if (ui.mode === UiMode.CONFIRM && answering?.phase !== phase) {
      const p = scene().getPlayerParty()[phase.partyMemberIndex];
      const asked: Learning = {
        slot: phase.partyMemberIndex,
        species: species(p),
        move: MoveId[phase.moveId],
        knows: p.getMoveset().map((m: any) => MoveId[m.moveId]),
      };
      let chosen = pick(asked, picked.length);
      if (chosen === undefined || !fits(chosen, asked)) {
        const why = chosen === undefined ? "leaves a move to learn, and names no pick" : "names a learn pick the prompt can't take";
        const knows = asked.knows.join(", ");
        illegal ??= `${why} (${asked.species} in slot ${asked.slot} learning ${asked.move}, knowing ${knows})`;
        chosen = declined(asked);
      }
      picked.push(chosen);
      answering = { phase, cursor: chosen.forget === null ? 4 : asked.knows.indexOf(chosen.forget), stage: "summary" };
      ui.processInput(Button.ACTION);
    } else if (answering?.phase === phase && answering.stage === "summary" && ui.mode === UiMode.SUMMARY) {
      answering.stage = answering.cursor === 4 ? "stop" : "done";
      ui.setCursor(answering.cursor);
      ui.processInput(Button.ACTION);
    } else if (answering?.phase === phase && answering.stage === "stop" && ui.mode === UiMode.CONFIRM) {
      // Asked only under the level-move confirmation setting (game-code.md §17).
      answering.stage = "done";
      ui.processInput(Button.ACTION);
    }
  }, 1);
  return { picked, illegal: () => illegal, stop: () => clearInterval(watch) };
}

/** A faint replacement the turn asks for: the field slot it fills, and those the party can send in. */
type Replacing = { field: number; offered: PartySlot[] };

type Choose = (asked: Replacing, i: number) => PartySlot | Replacement | undefined;

/**
 * Answers each party screen a turn opens as it opens, as upstream's own party-select helper does: a faint replacement's,
 * one per field slot in a double (#788), and a pivot's (#792). A pick missing or not fitting sends the first offered, so
 * the turn can end, and is the turn's illegal step.
 */
function replacing(choose: Choose, pivot: Choose) {
  const asked: Replacing[] = [];
  const pivots: Replacing[] = [];
  let illegal: string | undefined;
  let answered: unknown;
  const watch = setInterval(() => {
    const phase: any = scene().phaseManager.getCurrentPhase();
    const ui = scene().ui;
    if (!phase?.is("SwitchPhase") || !phase.isModal || answered === phase) return;
    if (ui.mode !== UiMode.PARTY || !ui.getHandler()?.active) return;
    answered = phase;
    const handler = ui.getHandler() as PartyUiHandler;
    const field: number = (handler as any).fieldIndex;
    const offered = scene()
      .getPlayerParty()
      .flatMap((p: any, slot: number) => (!p.isFainted() && !p.isOnField() ? [{ slot, species: species(p) }] : []));
    if (phase.doReturn && offered.length === 0) return;
    // A faint's screen is the one that returns no mon to its ball: a U-turn's or an Emergency Exit's does (game-code.md
    // §34).
    const what = phase.doReturn ? "pivot" : "faint replacement";
    const list = phase.doReturn ? pivots : asked;
    let chosen = (phase.doReturn ? pivot : choose)({ field, offered }, list.length);
    list.push({ field, offered });
    let wrong: string | undefined;
    if (chosen === undefined) wrong = `leaves a ${what} to pick, and names none`;
    else if (!offered.some(o => o.slot === chosen?.slot && o.species === chosen.species)) {
      wrong = `names a ${what} the party can't send in`;
    } else if ("field" in chosen && chosen.field !== field) {
      wrong = `names a ${what} for field ${chosen.field}, where the turn asks one for field ${field}`;
    }
    illegal ??= wrong;
    if (wrong !== undefined) chosen = offered[0];
    handler.setCursor((chosen as PartySlot).slot);
    handler.processInput(Button.ACTION);
    handler.processInput(Button.ACTION);
  }, 1);
  return { asked, pivots, illegal: () => illegal, stop: () => clearInterval(watch) };
}

type Asks = {
  choose?: Choose;
  pivot?: Choose;
  pick?: (asked: Learning, i: number) => LearnPick | undefined;
  /** The input the turn is held to: a turn the game plays for us takes one only once it asks for something (#702). */
  holds?: () => Input | null;
};

/**
 * One turn, to the next decision or to the battle's end. By default what the turn asks for is what the input names: its
 * faint replacements and its learn picks, each in the order asked.
 */
async function turn(input: Input | null, asks: Asks = {}): Promise<Turn> {
  const {
    choose = (_: Replacing, i: number) => replacementsOf(input)[i],
    pivot = (_: Replacing, i: number) => pivotsOf(input)[i],
    pick = (_: Learning, i: number) => input?.learns?.[i],
    holds = () => input,
  } = asks;
  command(input);
  const learns = learning(pick);
  const swaps = replacing(choose, pivot);
  let ended: Turn;
  try {
    ended = await toNextDecision();
  } finally {
    learns.stop();
    swaps.stop();
  }
  const illegal = learns.illegal() ?? swaps.illegal();
  if (illegal !== undefined) return { illegal };
  if ((holds()?.learns?.length ?? 0) > learns.picked.length) return { illegal: "names a learn pick no level-up asked for" };
  const named = replacementsOf(holds()).length;
  if (named > swaps.asked.length) {
    return {
      illegal:
        swaps.asked.length === 0
          ? `names a faint replacement, but nothing of ours fainted`
          : `names ${named} faint replacements, but the turn asked for ${swaps.asked.length}`,
    };
  }
  if (pivotsOf(holds()).length > swaps.pivots.length) return { illegal: "names a pivot no switch-out asked for" };
  return ended;
}

async function toNextDecision(): Promise<Turn> {
  const interceptor: any = game.phaseInterceptor;
  // A wipe never reaches TurnEndPhase; the interceptor reads its target afresh on every pass (#632).
  const watch = setInterval(() => {
    if (scene().phaseManager.getCurrentPhase()?.is("GameOverPhase")) interceptor.target = "GameOverPhase";
  }, 1);
  try {
    await interceptor.to("TurnEndPhase", false);
  } finally {
    clearInterval(watch);
  }
  // Stopped short of GameOverPhase, which clears the party.
  if (scene().phaseManager.getCurrentPhase().is("GameOverPhase")) return "lost";
  if (game.isVictory()) {
    // Where `Checkpoint` (oracle-line.ts) reads the last: not SelectModifierPhase, which a tenth wave never reaches
    // (game-code.md §12).
    await game.phaseInterceptor.to("BattleEndPhase");
    return "won";
  }
  await game.phaseInterceptor.to("TurnEndPhase");
  await game.phaseInterceptor.to("CommandPhase");
  return "on";
}

/**
 * A turn the game plays for us takes the next input only when that is one with no command and the turn asks for
 * something, a faint replacement or a learn pick: a rampage can play more than one such turn, and the ask can fall on any
 * of them (#702, #673).
 */
async function queuedTurn(inputs: Input[], next: number): Promise<{ input: Input | null; ended: Turn }> {
  const queued = isQueued(inputs[next]) ? inputs[next] : null;
  let taken = false;
  const ended = await turn(null, {
    choose: (_, i) => {
      taken = queued !== null;
      return replacementsOf(queued)[i];
    },
    pivot: (_, i) => {
      taken = queued !== null;
      return pivotsOf(queued)[i];
    },
    pick: (_, i) => {
      taken = queued !== null;
      return queued?.learns?.[i];
    },
    holds: () => (taken ? queued : null),
  });
  return { input: taken ? queued : null, ended };
}

async function boot() {
  // A second GameManager in one process needs what vitest does between tests: wrapping the shared UI's spies twice
  // recurses, and the old prompt interval would answer the new game's prompts (#655).
  if (boots > 0) vi.restoreAllMocks();
  clearInterval(PromptHandler.runInterval);
  PromptHandler.runInterval = undefined;
  game = new GameManager(phaserGame);
  boots++;
  kept = undefined;
  BattleScene.prototype.randBattleSeedInt = realRand;
  const constructed = scene().randBattleSeedInt === realRand;
  game.override.normalizeIVs = false;
  game.override.normalizeNatures = false;
  game.override.disableShinies = false;
  await game.classicMode.startBattle(1 as any);
  return constructed;
}

type Holder = { items(): Iterable<unknown>; drop(item: unknown): void };

/**
 * Where a replaced battle's objects stay reachable. A test reload skips the reset that destroys the old battle, and a
 * mock container drops its children without destroying them: every reload left about 1.1 MB alive until the worker
 * ran out of heap (#663).
 */
function holders(): Holder[] {
  const s = scene();
  const canvases = Phaser.Display.Canvas.CanvasPool as any;
  const icons: any[] = s.ui.handlers.flatMap((h: any) => (h?.iconAnimHandler?.icons ? [h.iconAnimHandler] : []));
  return [
    // Destroyed, not only dropped: a foe's battle info listens on the scene for the berries and moves it shows.
    { items: () => [...s.field.list], drop: o => s.field.remove(o, true) },
    { items: () => [...s.fieldUI.list], drop: o => s.fieldUI.remove(o, true) },
    { items: () => [...s.spriteTeraSparkleHandler.sprites], drop: o => s.spriteTeraSparkleHandler.remove(o) },
    ...icons.map(h => ({ items: () => [...h.icons.keys()], drop: (o: unknown) => h.icons.delete(o) })),
    { items: () => canvases.pool.flatMap((c: any) => c.parent ?? []), drop: o => canvases.remove(o) },
  ];
}

/** What the holders held before this GameManager's first reload, which no reload replaces. */
let kept: Set<unknown> | undefined;

/** `before` runs once the session is parsed, and before it loads. */
async function reload(session: string, before = () => {}) {
  const s = scene();
  const replaced = new Set(holders().flatMap(h => [...h.items()]));
  kept ??= replaced;
  (game.reload as any).sessionData = s.gameData.parseSessionData(session);
  // `initSessionFromData` clears `modifiers` and never `enemyModifiers` (#632).
  s.enemyModifiers = [];
  s.modifiers = [];
  // `initSession` destroys the old timer without taking it off the clock, which ticks it for the worker's life (#663).
  if (s.playTimeTimer) s.time.removeEvent(s.playTimeTimer);
  before();
  await game.reload.reloadSession();
  BattleScene.prototype.randBattleSeedInt = realRand;
  sweep(replaced);
}

function sweep(replaced: Set<unknown>) {
  for (const holder of holders()) {
    for (const item of holder.items()) if (replaced.has(item) && !kept?.has(item)) holder.drop(item);
  }
  const s = scene();
  // Never booted, so it never updates: what it queues stays queued.
  s.sys.updateList._pending.length = 0;
  s.sys.updateList._toProcess = 0;
  // Every sprite's animation state adds a listener here that nothing takes off.
  s.game.anims.off("remove");
  // Records the test framework keeps and nothing here reads.
  s.textures.list.length = 0;
  vi.clearAllMocks();
  game.phaseInterceptor.clearLogs();
  game.textInterceptor.clearLogs();
}

function migrated(session: any) {
  const copy = structuredClone(session);
  applySessionVersionMigration(copy);
  return copy;
}

async function load() {
  if (job.liveExport !== undefined) report.migrated = { save: migrated(job.save), liveExport: migrated(job.liveExport) };
  const saved = (report.migrated as { save: any } | undefined)?.save ?? job.save;
  const realRng = { constructed: await boot(), reloaded: false };
  let enemyItemsBeforeReload = 0;
  await reload(JSON.stringify(job.save), () => (enemyItemsBeforeReload = scene().enemyModifiers.length));
  realRng.reloaded = scene().randBattleSeedInt === realRand;
  if (job.at !== undefined) putBack(JSON.parse(job.at));

  report.hygiene = {
    realRng,
    overrides: [
      ...OVERRIDES.filter(name => activeOverrides[name] !== defaultOverrides[name]),
      ...unlikeTheSave("our", scene().getPlayerParty(), saved.party),
      ...unlikeTheSave("the foe's", scene().getEnemyParty(), saved.enemyParty),
    ],
    enemyItemsBeforeReload,
    items: { ours: stackTotals(scene().modifiers), foes: stackTotals(scene().enemyModifiers) },
  };
  report.battle = { wave: scene().currentBattle.waveIndex, battleSeed: scene().currentBattle.battleSeed };
  // Copied now: the export shares arrays with the mons, such as `moveHistory`, which the fight goes on to change.
  report.scene = JSON.parse(JSON.stringify(scene().gameData.getSessionSaveData()));
}

type Roll = { range: number; value: number };

/** Every call on the battle RNG since `readDraws`, which the hooks read their draws from. */
const rolls: Roll[] = [];
let draws: unknown[] = [];

/** The chance that `randBattleSeedInt(100)` falls under a threshold that need not be whole (game-code.md §5). */
const under100 = (threshold: number) => Math.min(100, Math.max(0, Math.ceil(threshold))) / 100;

const drew = (p: any, kind: string, chance: number, happened: boolean, about: object = {}) =>
  draws.push({ kind, side: p.isPlayer() ? "ours" : "foes", species: species(p), ...about, chance, happened });

function rolled<T>(run: () => T): [T, Roll[]] {
  const from = rolls.length;
  const result = run();
  return [result, rolls.slice(from)];
}

function wrap(owner: any, name: string, around: (original: (...args: any[]) => any, self: any, args: any[]) => any) {
  const original = owner.prototype[name];
  if (typeof original !== "function") throw new Error(`the game has no ${owner.name}.${name} to read draws from`);
  owner.prototype[name] = function (this: any, ...args: any[]) {
    return around(original, this, args);
  };
}

const effectOf = (attr: any) => {
  if (attr.is("StatusEffectAttr")) return { status: StatusEffect[attr.effect] };
  if (attr.is("AddBattlerTagAttr") || attr.is("AddArenaTagAttr")) return { tag: attr.tagType };
  if (attr.is("StatStageChangeAttr")) return { stats: attr.stats.map((s: number) => Stat[s]), stages: attr.stages };
  return { attr: attr.constructor.name };
};

/**
 * Reads each draw from the rolls the game's own method made, and changes nothing it plays: every wrapper hands back
 * what the method returned (#701).
 */
function readDraws() {
  const s = scene();
  const rand = s.randBattleSeedInt;
  /** The added effect being applied: its chance once asked, and whether the roll that follows it passed. */
  let effect: { chance?: number; at?: number; passed?: boolean } | null = null;
  s.randBattleSeedInt = function (this: any, range: number, min = 0) {
    const value = rand.call(this, range, min);
    rolls.push({ range, value: value - min });
    if (effect?.chance !== undefined && effect.at === rolls.length - 1 && range === 100) effect.passed = value < effect.chance;
    return value;
  };

  let accuracy = 0;
  let multiplier: number | undefined;
  wrap(Move, "calculateBattleAccuracy", (f, move, args) => (accuracy = f.apply(move, args)));
  wrap(Pokemon, "getAccuracyMultiplier", (f, p, args) => (multiplier = f.apply(p, args)));
  wrap(MoveEffectPhase, "hitCheck", (f, phase, args) => {
    multiplier = undefined;
    const entry = f.apply(phase, args);
    // Asked for only on the way to the roll: a hit check that never rolled leaves it unset (game-code.md §5).
    if (multiplier !== undefined) {
      drew(phase.getUserPokemon(), "accuracy", under100(accuracy * multiplier), entry[0] === HitCheckResult.HIT, {
        move: MoveId[phase.move.id],
      });
    }
    return entry;
  });

  wrap(Pokemon, "getCriticalHitResult", (f, target, args) => {
    const [source, move] = args;
    const [crit, during] = rolled(() => f.apply(target, args));
    // No roll where the crit was sure or impossible (game-code.md §1).
    if (during.length > 0) drew(source, "crit", 1 / during[0].range, crit, { move: MoveId[move.id] });
    return crit;
  });

  // The game asks an effect's chance outside a hit too, scoring the foe's moves, and rolls nothing after.
  wrap(MoveEffectAttr, "getMoveChance", (f, attr, args) => {
    const chance = f.apply(attr, args);
    if (effect && chance >= 0 && chance < 100) Object.assign(effect, { chance, at: rolls.length });
    return chance;
  });
  // Each instance, not the class: a subclass's `apply` calls its parent's, and the instance's runs once per use. A roll
  // that passed can still add nothing, such as a burn on a foe the hit knocked out.
  for (const move of allMoves) {
    for (const attr of move.attrs as any[]) {
      if (!attr.is("MoveEffectAttr")) continue;
      const apply = attr.apply;
      attr.apply = function (this: any, user: any, ...rest: any[]) {
        const outer = effect;
        const mine: NonNullable<typeof effect> = {};
        effect = mine;
        try {
          const applied = apply.call(this, user, ...rest);
          if (mine.passed !== undefined) {
            drew(user, "effect", under100(mine.chance as number), mine.passed && applied !== false, {
              move: MoveId[move.id],
              effect: effectOf(attr),
            });
          }
          return applied;
        } finally {
          effect = outer;
        }
      };
    }
  }

  const items: [any, (m: any) => number][] = [
    [BypassSpeedChanceModifier, m => m.getStackCount() / 10],
    [FlinchChanceModifier, m => (m.getStackCount() * m.chance) / 100],
    [SurviveDamageModifier, m => m.getStackCount() / 10],
  ];
  for (const [item, chance] of items) {
    wrap(item, "apply", (f, m, args) => {
      const [procced, during] = rolled(() => f.apply(m, args));
      if (during.length > 0) drew(args[0], "item", Math.min(1, chance(m)), procced, { item: m.type.id });
      return procced;
    });
  }

  wrap(MovePhase, "checkPara", (f, phase, args) => {
    const [stopped, during] = rolled(() => f.apply(phase, args));
    if (during.length > 0) drew(phase.pokemon, "paralysis", 1 / during[0].range, stopped);
    return stopped;
  });
  wrap(ConfusedTag, "lapse", (f, tag, args) => {
    const [kept, during] = rolled(() => f.apply(tag, args));
    // The first roll is whether it hits itself, at 0; a self-hit then rolls its damage.
    if (during.length > 0) drew(args[0], "confusion", 1 / during[0].range, during[0].value === 0);
    return kept;
  });
}

async function play() {
  const steps: unknown[] = [];
  report.steps = steps;
  let next = 0;
  for (;;) {
    const at = scene().currentBattle.turn;
    let input: Input | null;
    let ended: Turn;
    if (!asksCommand()) {
      draws = [];
      ({ input, ended } = await queuedTurn(job.inputs, next));
      if (input) next++;
    } else {
      if (next === job.inputs.length) return "open";
      input = job.inputs[next];
      const offered = legal();
      if (!offered.some(o => same(o, input as Input))) {
        return { illegal: { index: next, turn: at, why: "isn't offered", legal: offered } };
      }
      next++;
      draws = [];
      ended = await turn(input);
    }
    if (typeof ended === "object") {
      return { illegal: { index: input === null ? null : next - 1, turn: at, why: ended.illegal, legal: [] } };
    }
    steps.push({ turn: at, input, checkpoint: checkpoint(), strayPrompts: strayPrompts(), draws });
    if (ended !== "on") return ended;
  }
}

// An entry's `pokemon` is the live mon, which only its id names across a reload (game-code.md §30).
const faints = (history: any[]) => history.map(f => ({ id: f.pokemon.id, turn: f.turn }));

/** The save at a decision, and the live fields a reload loses or resets (#636, #655). */
function forkPoint(): string {
  const s = scene();
  const battle = s.currentBattle;
  const all: any[] = [...s.getPlayerParty(), ...s.getEnemyParty()];
  return JSON.stringify({
    session: JSON.stringify(s.gameData.getSessionSaveData()),
    double: battle.double,
    turn: battle.turn,
    rng: Phaser.Math.RND.state(),
    battleSeedState: battle.battleSeedState,
    switchCounter: battle.enemySwitchCounter,
    lastMove: battle.lastMove,
    enemyFaints: battle.enemyFaints,
    faints: { ours: faints(battle.playerFaintsHistory), foes: faints(battle.enemyFaintsHistory) },
    // A reload empties it, and the next KO's EXP skipped every mon switched out before the fork point (#673,
    // game-code.md §30).
    participants: [...battle.playerParticipantIds],
    teamIndex: Object.fromEntries(s.getEnemyParty().map((p: any) => [p.id, p.initialTeamIndex])),
    bossIndex: Object.fromEntries(s.getEnemyParty().map((p: any) => [p.id, p.bossSegmentIndex])),
    temp: Object.fromEntries(all.map(p => [p.id, { turnCount: p.summonData.turnCount, waveTurnCount: p.summonData.waveTurnCount }])),
    wave: Object.fromEntries(all.map(p => [p.id, { ...p.waveData, abilitiesApplied: [...p.waveData.abilitiesApplied] }])),
    summon: Object.fromEntries(all.filter(p => p.isOnField()).map(p => [p.id, JSON.parse(JSON.stringify(p.summonData))])),
    status: Object.fromEntries(
      all.filter(p => p.status).map(p => [p.id, { toxic: p.status.toxicTurnCount, sleep: p.status.sleepTurnsRemaining }]),
    ),
  });
}

/** Set after a lost turn: the next reload may throw, and a fresh GameManager recovers (#655). */
let dirty = false;

async function loadSession(session: string) {
  strayPrompts();
  try {
    await reload(session);
  } catch (err) {
    if (!dirty) throw err;
    await boot();
    await reload(session);
  }
  dirty = false;
}

async function restore(at: string) {
  // Parsed afresh each time: `PokemonSummonData` keeps the arrays it is given, so a turn played after a restore
  // would write back into a shared copy, and a fork point restored twice would come back changed (#655).
  const fork = JSON.parse(at);
  await loadSession(fork.session);
  putBack(fork);
}

/**
 * A load sends out the foes a faint left (game-code.md §35): a fainted wild foe goes back on the field, and a trainer's
 * last able mon into a fainted one's field slot ahead of its own. Puts each foe back in its saved slot, with the command
 * the load queued for it, and takes a fainted one off the field again as its faint did, out of sight (#792).
 */
function asFainted(saved: { id: number }[]) {
  const s = scene();
  const party: any[] = s.getEnemyParty();
  const levels: any[][] = s.phaseManager.phaseQueue.levels;
  const commands = levels.flat().flatMap(p => (p.is("EnemyCommandPhase") ? [[p, s.getEnemyField()[p.fieldIndex]]] : []));
  const slot = new Map(saved.map(({ id }, i) => [id, i]));
  party.sort((a, b) => (slot.get(a.id) ?? 0) - (slot.get(b.id) ?? 0));
  for (const [phase, foe] of commands) phase.fieldIndex = s.getEnemyField().indexOf(foe);
  for (const p of s.getEnemyField()) {
    if (!p.isFainted() || !p.isOnField()) continue;
    p.hideInfo();
    p.switchOutStatus = true;
    s.field.remove(p);
  }
}

/** Onto the scene its session just loaded. */
function putBack(fork: any) {
  const s = scene();
  const battle = s.currentBattle;
  // From the live battle on an augmented export's: a tab reloaded mid-fight is single where the fight it left was not
  // (game-code.md §34).
  if (fork.double) toDouble();
  if (battle.double) asFainted(JSON.parse(fork.session).enemyParty);
  const all: any[] = [...s.getPlayerParty(), ...s.getEnemyParty()];
  battle.turn = fork.turn;
  battle.battleSeedState = fork.battleSeedState;
  battle.enemySwitchCounter = fork.switchCounter;
  battle.lastMove = fork.lastMove;
  battle.enemyFaints = fork.enemyFaints;
  const mons = (history: { id: number; turn: number }[]) =>
    history.map(({ id, turn }) => ({ pokemon: all.find(p => p.id === id), turn }));
  battle.playerFaintsHistory = mons(fork.faints.ours);
  battle.enemyFaintsHistory = mons(fork.faints.foes);
  // An augmented export's fork point has none (`src/solver/extras.ts`), so a mid-fight solve keeps the reload's: the
  // mon on the field alone.
  if (fork.participants) battle.playerParticipantIds = new Set(fork.participants);
  Phaser.Math.RND.state(fork.rng);
  // A load gives the trainer's Tera slot its specialty type again, by party slot: after a switch, another mon's
  // (game-code.md §30).
  const { party, enemyParty, arena } = JSON.parse(fork.session);
  // The foe's summon fires its entry ability again, and a weather or terrain the fight had seen end came back for five
  // turns: Drizzle's rain changed a later turn of a solved double (#792, game-code.md §35).
  const { weather, terrain } = arena;
  s.arena.weather = weather ? new Weather(weather.weatherType, weather.turnsLeft, weather.maxDuration) : null;
  s.arena.terrain = terrain ? new Terrain(terrain.terrainType, terrain.turnsLeft, terrain.maxDuration) : null;
  const teraTypes = new Map([...party, ...enemyParty].map((m: any) => [m.id, m.teraType]));
  for (const p of all) {
    p.teraType = teraTypes.get(p.id) ?? p.teraType;
    const wave = fork.wave[p.id];
    p.waveData.endured = wave.endured;
    p.waveData.abilityRevealed = wave.abilityRevealed;
    p.waveData.abilitiesApplied = new Set(wave.abilitiesApplied);
    const status = fork.status[p.id];
    if (status && p.status) {
      p.status.toxicTurnCount = status.toxic;
      p.status.sleepTurnsRemaining = status.sleep;
    }
  }
  // A load gives the classic final boss its first stage's bars again, whatever the save holds (game-code.md §34).
  const bars = new Map(enemyParty.map((m: any) => [m.id, m.bossSegments]));
  for (const p of s.getEnemyParty()) {
    p.initialTeamIndex = fork.teamIndex[p.id];
    if (p.bossSegments) p.bossSegments = bars.get(p.id) || p.bossSegments;
    if (p.bossSegments) p.bossSegmentIndex = fork.bossIndex[p.id];
  }
  // Ours too, though the save keeps it: the reload's summon fires entry abilities again, and a foe's Intimidate took a
  // second stage off our lead at every fork point it was on the field for (#662).
  for (const p of [...s.getPlayerField(), ...s.getEnemyField()]) {
    if (fork.summon[p.id]) p.summonData = new PokemonSummonData(fork.summon[p.id]);
  }
  // After the summon data, which a copy constructs with the turn counts at 1: its `toJSON` leaves them out.
  for (const p of all) Object.assign(p.summonData, fork.temp[p.id]);
}

/**
 * A reload loads a double with one foe as a single (game-code.md §28), with our second mon off the field and no command
 * asked of it. Put on the field without a summon, which would apply its entry abilities a second time (#662, #788).
 */
function toDouble() {
  const s = scene();
  s.currentBattle.double = true;
  // Party slot 1 is who stood in field slot 1: the summon swaps its mon into that slot (game-code.md §34). One that can't
  // fight there means none stood.
  const [lead, partner] = s.getPlayerParty();
  if (!partner?.isAllowedInBattle() || partner.isOnField()) return;
  s.add.existing(partner);
  s.field.add(partner);
  partner.setVisible(true);
  lead.setFieldPosition(FieldPosition.LEFT, 0);
  partner.setFieldPosition(FieldPosition.RIGHT, 0);
  // Where the turn's start queues it, ahead of the foe's command: unshifted, it would run ahead of the target screen our
  // lead's command unshifts, and that screen's prompt would expire unanswered (#788).
  const manager = s.phaseManager;
  const levels: any[][] = manager.phaseQueue.levels;
  const second = manager.create("CommandPhase", 1);
  const level = levels.find(l => l.some(p => p.is("EnemyCommandPhase")));
  if (level !== undefined) return void level.splice(level.findIndex(p => p.is("EnemyCommandPhase")), 0, second);
  // A lead playing a queued move ends the reload's command at once, leaving the foe's command shifted off the head of
  // the top level but not yet started as the current phase (game-code.md §35): every double fork point with one failed
  // the solve (#918).
  const current = manager.getCurrentPhase();
  if (!current?.is("EnemyCommandPhase")) throw new Error("the reload queued no foe's command to put our second one ahead of");
  levels.at(-1)!.unshift(current);
  manager.currentPhase = second;
}

const hp = () => {
  const s = scene();
  const share = (p: any) => (p.isFainted() ? 0 : p.hp / p.getMaxHp());
  // The classic final boss comes back at full HP in its second form (game-code.md §34), so it counts as two lives, the
  // first form's above the second's: crossing into the second stage is progress to the search, not a heal (#788).
  const foe = (p: any) => (s.currentBattle.isClassicFinalBoss ? (share(p) + (p.formIndex === 0 ? 1 : 0)) / 2 : share(p));
  return { ours: s.getPlayerParty().map(share), foes: s.getEnemyParty().map(foe) };
};

const stages = () => {
  const s = scene();
  const of = (p: any): number[] => (p.isOnField() && !p.isFainted() ? [...p.getStatStages()] : []);
  return { ours: s.getPlayerParty().map(of), foes: s.getEnemyParty().map(of) };
};

/** Leaves the draws out: of two paths it merges, the search keeps one's draws and drops the other's (#655). */
function sig(): string {
  const s = scene();
  const pokemon = (p: any) =>
    [
      p.species.speciesId,
      p.formIndex,
      p.level,
      p.exp,
      s.currentBattle.playerParticipantIds.has(p.id) ? 1 : 0,
      p.hp,
      p.isOnField() ? 1 : 0,
      p.status?.effect ?? 0,
      p.status?.toxicTurnCount ?? 0,
      p.status?.sleepTurnsRemaining ?? 0,
      p.isTerastallized ? 1 : 0,
      p.isOnField() ? p.getStatStages().join(".") : "",
      p.isOnField() ? p.summonData.tags.map((t: any) => `${t.tagType}/${t.turnCount}`).join(".") : "",
      // A pending recharge, rampage turn or charge turn (#655).
      p.isOnField() ? p.getMoveQueue().map((q: any) => q.move).join(".") : "",
      p.getMoveset().map((m: any) => `${m.moveId}/${m.ppUsed}`).join("."),
      p.getHeldItems().map((item: any) => `${item.type.id}${item.stackCount}`).join("."),
    ].join(":");
  return [
    s.currentBattle.turn,
    s.currentBattle.double ? 1 : 0,
    s.arena.playerTerasUsed,
    s.currentBattle.enemySwitchCounter,
    s.arena.weather?.weatherType ?? 0,
    s.arena.terrain?.terrainType ?? 0,
    s.arena.tags.map((t: any) => `${t.tagType}/${t.side}/${t.turnCount}`).join("."),
    ...s.getPlayerParty().map(pokemon),
    "|",
    ...s.getEnemyParty().map(pokemon),
  ].join(",");
}

const position = () => ({
  sig: sig(),
  hp: hp(),
  stages: stages(),
  legal: asksCommand() ? legal() : [null],
  forkPoint: forkPoint(),
});

/**
 * As its turn played it: the command, then what the turn asked for, a `queued` input on a turn with no command. A turn
 * that started double names it all in a `double` input (#788).
 */
function naming(
  input: Input | null,
  learns: LearnPick[],
  replacements: Replacement[],
  pivots: Replacement[],
  wasDouble: boolean,
): Input | null {
  if (input?.kind === "double" || (wasDouble && (input === null || input.kind === "queued"))) {
    const commands = input?.kind === "double" ? input.commands : [null, null];
    if (commands.every(c => c === null) && learns.length + replacements.length + pivots.length === 0) return null;
    return {
      kind: "double",
      commands,
      ...(pivots.length > 0 && { pivots }),
      ...(learns.length > 0 && { learns }),
      ...(replacements.length > 0 && { replacements }),
    };
  }
  const slotOf = ({ slot, species }: Replacement): PartySlot => ({ slot, species });
  const replacement = replacements[0] && slotOf(replacements[0]);
  const asked: Asked = {
    ...(pivots.length > 0 && { pivots: pivots.map(slotOf) }),
    ...(learns.length > 0 && { learns }),
    ...(replacement !== undefined && { replacement }),
  };
  if (input !== null && input.kind !== "queued") {
    const { learns: _learns, replacement: _replacement, pivots: _pivots, ...played } = input;
    return { ...played, ...asked };
  }
  return asked.learns || asked.replacement || asked.pivots ? { kind: "queued", ...asked } : null;
}

async function expand(at: string, inputs: (Input | null)[]) {
  const children: unknown[] = [];
  const queue = [...inputs];
  while (queue.length > 0) {
    const input = queue.shift() as Input | null;
    await restore(at);
    const wasDouble = double();
    const named = input?.learns ?? [];
    const namedSwaps = replacementsOf(input);
    const namedPivots = pivotsOf(input);
    const asked: Learning[] = [];
    const swaps: Replacing[] = [];
    const pivotScreens: Replacing[] = [];
    let ended: Turn;
    try {
      ended = await turn(input, {
        choose: (replacing, i) => {
          swaps.push(replacing);
          return namedSwaps[i] ?? replacing.offered[0];
        },
        pivot: (replacing, i) => {
          pivotScreens.push(replacing);
          return namedPivots[i] ?? replacing.offered[0];
        },
        pick: (prompt, i) => {
          asked.push(prompt);
          return named[i] ?? declined(prompt);
        },
      });
    } catch (err) {
      dirty = true;
      ended = { illegal: `threw ${err instanceof Error ? err.message : String(err)}`.split("\n")[0] };
    }
    const learns = asked.map((prompt, i) => named[i] ?? declined(prompt));
    const sent = (screens: Replacing[], names: (PartySlot | Replacement)[]) =>
      screens.map(({ field, offered }, i) => {
        const { slot, species } = names[i] ?? offered[0];
        return { slot, species, field };
      });
    const replacements = sent(swaps, namedSwaps);
    const pivots = sent(pivotScreens, namedPivots);
    const played = naming(input, learns, replacements, pivots, wasDouble);
    // Each pick the input left open is a sibling of its own, the picks before it as played and what follows it open. A
    // won or lost turn's picks change nothing after it. A pivot's sibling leaves the turn's learn picks and replacements
    // open, and theirs keep its pivots as played.
    for (let i = namedPivots.length; i < pivotScreens.length; i++) {
      const { field, offered } = pivotScreens[i];
      queue.push(...offered.slice(1).map(other => naming(input, [], [], [...pivots.slice(0, i), { ...other, field }], wasDouble)));
    }
    if (ended !== "won" && ended !== "lost") {
      for (let i = named.length; i < asked.length; i++) {
        for (const forget of asked[i].knows) {
          queue.push(naming(input, [...learns.slice(0, i), { ...declined(asked[i]), forget }], [], pivots, wasDouble));
        }
      }
    }
    for (let i = namedSwaps.length; i < swaps.length; i++) {
      const { field, offered } = swaps[i];
      queue.push(
        ...offered.slice(1).map(other => naming(input, learns, [...replacements.slice(0, i), { ...other, field }], pivots, wasDouble)),
      );
    }
    const stray = strayPrompts();
    if (ended === "lost") dirty = true;
    if (typeof ended === "object") children.push({ input: played, end: "dropped", why: ended.illegal });
    else if (stray > 0) children.push({ input: played, end: "dropped", why: `left ${stray} prompts queued` });
    else if (ended === "on") children.push({ input: played, end: "on", at: position() });
    else children.push({ input: played, end: ended, hp: hp() });
  }
  const { used_heap_size, heap_size_limit } = getHeapStatistics();
  const mb = (bytes: number) => Math.round(bytes / 2 ** 20);
  return { children, heap: { usedMb: mb(used_heap_size), limitMb: mb(heap_size_limit) } };
}

type Played = { input: Input | null; turn: number; checkpoint: unknown; end: Turn };

async function checks(inputs: Input[]) {
  if (job.at === undefined) await loadSession(JSON.stringify(job.save));
  else await restore(job.at);
  const straight: Played[] = [];
  const forks: string[] = [];
  let next = 0;
  for (;;) {
    const at = scene().currentBattle.turn;
    let input: Input | null;
    let end: Turn;
    if (!asksCommand()) {
      forks.push(forkPoint());
      ({ input, ended: end } = await queuedTurn(inputs, next));
      if (input) next++;
    } else {
      input = inputs[next] ?? null;
      if (input === null) break;
      if (isQueued(input)) throw new Error(`input ${next + 1} is for a turn the game plays for us, but turn ${at} asks for one`);
      if (!legal().some(o => same(o, input as Input))) throw new Error(`input ${next + 1} isn't offered on turn ${at}`);
      next++;
      forks.push(forkPoint());
      end = await turn(input);
    }
    straight.push({ input, turn: at, checkpoint: checkpoint(), end });
    if (end !== "on") break;
  }
  const differs = (from: number, i: number, got: Played) =>
    JSON.stringify([got.checkpoint, got.end]) === JSON.stringify([straight[i].checkpoint, straight[i].end])
      ? []
      : [{ from: straight[from].turn, turn: straight[i].turn, want: straight[i], got }];
  const replayFrom = async (from: number, chained: boolean) => {
    await restore(forks[from]);
    const misses: unknown[] = [];
    for (let i = from; i < straight.length; i++) {
      if (chained && i > from) await restore(forkPoint());
      const at = scene().currentBattle.turn;
      const end = await turn(straight[i].input);
      const got = { input: straight[i].input, turn: at, checkpoint: checkpoint(), end };
      misses.push(...differs(from, i, got));
      if (end !== "on" || misses.length > 0) break;
    }
    return misses;
  };
  const fork: unknown[] = [];
  for (let from = 1; from < straight.length; from++) fork.push(...(await replayFrom(from, false)));
  const chain = straight.length > 0 ? await replayFrom(0, true) : [];
  return { straight: straight.map(({ turn, end }) => ({ turn, end })), fork, chain };
}

/** A later solve in the fight a warm worker serves starts here: loaded as `load` loads the first (#677). */
async function rootAt(save: any, at?: string) {
  job.save = save;
  job.at = at;
  if (at === undefined) await loadSession(JSON.stringify(save));
  else await restore(at);
  return { root: position() };
}

async function serve(port: number) {
  const socket = connect(port, "127.0.0.1");
  await new Promise<void>((resolve, reject) => socket.once("connect", resolve).once("error", reject));
  const send = (message: unknown) => socket.write(`${JSON.stringify(message)}\n`);
  await load();
  send({ kind: "root", root: position() });
  for await (const line of createInterface({ input: socket })) {
    const asked = JSON.parse(line);
    try {
      const answer =
        asked.kind === "expand"
          ? await expand(asked.forkPoint, asked.inputs)
          : asked.kind === "root"
            ? await rootAt(asked.save, asked.at)
            : await checks(asked.inputs);
      send({ id: asked.id, ...answer });
    } catch (err) {
      dirty = true;
      send({ id: asked.id, error: err instanceof Error ? (err.stack ?? err.message) : String(err) });
    }
  }
}

describe("coach harness", () => {
  beforeAll(() => {
    phaserGame = new Phaser.Game({ type: Phaser.HEADLESS });
  });

  it.skipIf(PORT !== undefined)(
    "replay",
    async () => {
      let timer: ReturnType<typeof setTimeout> | undefined;
      // Inside vitest's own timeout, which would end the test before it writes the report.
      const deadline = new Promise<never>((_, reject) => {
        timer = setTimeout(() => reject(new Error(`the replay timed out after ${DEADLINE_MS / 1000} s`)), DEADLINE_MS);
      });
      try {
        report.version = JSON.parse(readFileSync("package.json", "utf8")).version;
        await Promise.race([
          (async () => {
            await load();
            readDraws();
            report.end = await play();
          })(),
          deadline,
        ]);
      } catch (err) {
        report.error = err instanceof Error ? (err.stack ?? err.message) : String(err);
      } finally {
        clearTimeout(timer);
      }
      writeFileSync(process.env.COACH_OUT as string, JSON.stringify(report));
    },
    DEADLINE_MS + 60_000,
  );

  it.runIf(PORT !== undefined)(
    "serve",
    async () => {
      // Left on, the game's log of every phase piles up in the runner's copy of vitest's output for the worker's whole
      // life (#662).
      for (const quiet of ["log", "info", "debug", "warn"] as const) console[quiet] = () => {};
      try {
        report.version = JSON.parse(readFileSync("package.json", "utf8")).version;
        await serve(Number(PORT));
      } catch (err) {
        report.error = err instanceof Error ? (err.stack ?? err.message) : String(err);
      }
      // An interrupted coordinator closes the socket and removes its files at once: written after that, the report
      // would be left in the clone (#658).
      if (existsSync(process.env.COACH_IN as string)) writeFileSync(process.env.COACH_OUT as string, JSON.stringify(report));
    },
    24 * 3_600_000,
  );
});
