{
  // `.wxt/tsconfig.json` is generated by `wxt prepare` (which `npm run typecheck` runs first) and carries the browser
  // types and the DOM lib. Everything below either matches the repo root's settings or is what this package needs.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": false
  }
}
