{
  "name": "coachemon",
  "version": "1.92.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/server.ts",
    "smoke": "node scripts/smoke.ts",
    "lag:run": "node scripts/autoplay.ts --lag",
    "lag:report": "node scripts/lag-report.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && node skills/coachemon/scripts/test/run.mjs",
    "typecheck": "tsc",
    "enums:gen": "node scripts/gen-enums.ts",
    "listing:render": "node scripts/listing/render.ts",
    "randbats:gen": "node scripts/gen-randbats.ts",
    "release:safari": "node scripts/release/safari-release.ts",
    "drift:check": "node scripts/drift.ts",
    "clone:provision": "node scripts/clone-provision/run.ts",
    "clone:smoke": "node scripts/clone-smoke/run.ts",
    "oracle:battle": "node scripts/battle-oracle/run.ts",
    "oracle:encounter": "node scripts/encounter-oracle/run.ts",
    "oracle:preview": "node scripts/preview-stability/run.ts",
    "recheck:promote": "node scripts/recheck/promote-run.ts",
    "library:replay": "node scripts/library-replay/run.ts",
    "bump:suite": "node scripts/bump-suite/run.ts",
    "ladder:drift": "node scripts/drift.ts",
    "reads:check": "node scripts/game-reads/main.ts",
    "library:import": "node scripts/library-import/run.ts",
    "library:tally": "node scripts/library-tally/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  }
}
