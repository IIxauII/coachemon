      const coming = names[i + 1];
      const plural = `${left} mon${left === 1 ? "" : "s"} left after this one`;
      expect(runLines[i], `turn ${i + 1} names the mon the game then summoned`).toMatch(
        new RegExp(`^let it go — ${coming}( ★shiny)? L\\d+( \\(hidden ability\\))? is next, ${plural}$`),
      );
    }

    pressOverride(game, RUN);
    await runOptionOut(game);

    console.log(`ORACLE-DIFF safari-count seen=${seen.join(" ")} continuous=${me.continuousEncounter}`);
    expect(me.continuousEncounter, "letting the last of the three go ends the continuous encounter").toBe(false);
  });
});
