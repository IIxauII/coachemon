  it("Dark Deal: the mon the card says is taken is the mon the game takes", async () => {
    await arrive(game, caseFor(MysteryEncounterType.DARK_DEAL));

    const card = readCard(game);
    const claimed: string = card.options[0].outcome;
    expect(card.options[0].exact, "the card claims an exact victim and tier").toBe(true);
    const named = /^(.+?) is taken for good → .*starter tier ([\d–]+)/.exec(claimed);
    expect(named, `option 1 reads "${claimed}"`).toBeTruthy();
    const [, who, tier] = named!;
    const before = game.scene.getPlayerParty().map(p => p.name);
    expect(before, `the card's ${who} is in the party`).toContain(who);

    await chooseOption(game, 1);

    const me = game.scene.currentBattle.mysteryEncounter!;
    const taken = me.dialogueTokens.pokeName;
    const after = game.scene.getPlayerParty().map(p => p.name);
    console.log(`ORACLE-DIFF dark-deal claimed=${who} actual=${taken} party=${before} → ${after}`);
    expect(taken).toBe(who);
    expect(after, `${who} is gone from the party`).not.toContain(who);

    // Only the boss can tell the tier, and its cost is the claim only while the band was servable: the game widens a
    // band with no starter of the taken mon's types (game-code.md §13).
    await runOptionOut(game, { isBattle: true });
    const boss = game.scene.getEnemyParty()[0];
    const cost = speciesDataRegistry.getStarterCost(boss.species.speciesId);
    const [min, max = min] = tier.split("–").map(Number);
    expect(Number.isFinite(min) && Number.isFinite(max), `the card's tier "${tier}" reads as a band`).toBe(true);
    const types: number[] = me.misc.removedTypes;
    const servable = speciesDataRegistry
      .getAllStarters(true)
      .filter(s => s && (types.includes(s.type1) || (s.type2 != null && types.includes(s.type2))))
      .some(s => {
        const c = speciesDataRegistry.getStarterCost(s.speciesId);
        return c >= min && c <= max;
      });
    console.log(`ORACLE-DIFF dark-deal-tier claimed=${tier} boss=${boss.species.name} cost=${cost} servable=${servable}`);
    // Asserted rather than guarded, so a pin bump that makes the game widen goes red instead of asserting nothing.
    // `servable` ignores the game's excluded bosses, so it is the wider test: false means the band really was unservable.
    expect(servable, `starter tier ${tier} has a starter of types ${types} to draw from`).toBe(true);
    expect(cost, `the card claimed tier ${tier}; ${boss.species.name} costs ${cost}`).toBeGreaterThanOrEqual(min);
    expect(cost).toBeLessThanOrEqual(max);
  });

