describe("Coachemon oracle - Mystery Encounter card, common, great, ultra and rogue tiers", () => {
  let phaserGame: Phaser.Game;
  let game: GameManager;

  beforeAll(() => {
    phaserGame = new Phaser.Game({ type: Phaser.HEADLESS });
  });

  beforeEach(() => {
    game = new GameManager(phaserGame);
  });

  it.each(CASES)("$name", async testCase => {
    const { type, known = true } = testCase;
    await arrive(game, testCase);

    const card = readCard(game);
    const me = game.scene.currentBattle.mysteryEncounter!;
    console.log(`ORACLE ${JSON.stringify({ type, card })}`);

    expect(card.kind).toBe("encounter");
    // Every note the card carries about its own failure is a port that threw against the real game.
    expect(card.notes.filter((n: string) => n.startsWith("couldn't judge"))).toEqual([]);
    expect(card.known).toBe(known);
    // One card row per option the game offers, in the game's own order.
    expect(card.options).toHaveLength(me.options.length);
    expect(card.options.map((o: { index: number }) => o.index)).toEqual(me.options.map((_, i: number) => i));
    for (const o of card.options) {
      expect(o.label).toBeTruthy();
      expect(o.label).not.toMatch(/^Option \d$/);
    }
    if (known) {
      // A judged encounter prices every option it offers.
      for (const o of card.options) {
        expect(o.outcome, `option ${o.index} (${o.label}) has no outcome`).toBeTruthy();
      }
    }
  });
});

/** Picks an option on the encounter screen and stops with `MysteryEncounterOptionSelectedPhase` up but not yet run:
 *  the pre-option fork has drawn, so what the game rolled can be read before its branch is taken. The head of
 *  upstream's own helper (we are already on the option screen, so its leading `to("MysteryEncounterPhase")` would
 *  wait for a phase that has already started). */
async function chooseOption(game: GameManager, optionNo: number, { pokemonNo }: { pokemonNo?: number } = {}) {
  const ui = game.scene.ui.getHandler<MysteryEncounterUiHandler>();
  ui.unblockInput();
  switch (optionNo) {
    case 2:
      ui.processInput(Button.RIGHT);
      break;
    case 3:
      ui.processInput(Button.DOWN);
      break;
    case 4:
      ui.processInput(Button.RIGHT);
      ui.processInput(Button.DOWN);
      break;
    default:
      break;
  }

  if (pokemonNo == null) {
    ui.processInput(Button.ACTION);
  } else {
    const partyUi = game.scene.ui.handlers[UiMode.PARTY] as PartyUiHandler;
    vi.spyOn(partyUi, "show");
    ui.processInput(Button.ACTION);
    await vi.waitFor(() => expect(partyUi.show).toHaveBeenCalled());
    for (let i = 1; i < pokemonNo; i++) {
      partyUi.processInput(Button.DOWN);
    }
    partyUi.processInput(Button.ACTION);
    partyUi.processInput(Button.ACTION);
  }

  await game.phaseInterceptor.to("MysteryEncounterOptionSelectedPhase", false);
}

/** Runs a chosen option out: to the first turn of the fight it starts, or to the rewards it leaves behind. */
async function runOptionOut(game: GameManager, { isBattle = false }: { isBattle?: boolean } = {}) {
  game.onNextPrompt(
    "MysteryEncounterOptionSelectedPhase",
    UiMode.MESSAGE,
    () => {
      game.scene.ui.getHandler<MysteryEncounterUiHandler>().processInput(Button.ACTION);
    },
    () => game.isCurrentPhase("MysteryEncounterBattlePhase", "MysteryEncounterRewardsPhase"),
  );

  if (!isBattle) {
    return await game.phaseInterceptor.to("MysteryEncounterRewardsPhase");
  }
  await game.toNextTurn();
}

/** Picks an option on the encounter screen and runs it out. */
async function pickOption(
  game: GameManager,
  optionNo: number,
  { isBattle = false, pokemonNo }: { isBattle?: boolean; pokemonNo?: number } = {},
) {
  await chooseOption(game, optionNo, { pokemonNo });
  return await runOptionOut(game, { isBattle });
}

/** The reward options the game is offering right now, once it has reached its `SelectModifierPhase`. */
function rewardOptions(game: GameManager) {
  expect(game.scene.ui.getMode()).toBe(UiMode.MODIFIER_SELECT);
  const handler = game.scene.ui.handlers.find(h => h instanceof ModifierSelectUiHandler) as ModifierSelectUiHandler;
  return handler.options.map(o => o.modifierTypeOption.type);
}

describe("Coachemon oracle - what the card claims against what the game does", () => {
  let phaserGame: Phaser.Game;
  let game: GameManager;

  beforeAll(() => {
    phaserGame = new Phaser.Game({ type: Phaser.HEADLESS });
  });

  beforeEach(() => {
    game = new GameManager(phaserGame);
  });

  // The destination is the option fork's first draw (×500). The card names it before the player commits.
  it("Teleporting Hijinks: the biome the card names is the biome the game teleports to", async () => {
    await arrive(game, caseFor(MysteryEncounterType.TELEPORTING_HIJINKS));

    const card = readCard(game);
    const claimed = /teleport to ([A-Za-z ]+?)(?:,|$)/.exec(card.options[0].outcome)?.[1];
    expect(card.options[0].exact, "the card claims an exact destination").toBe(true);
    expect(claimed).toBeTruthy();

    await pickOption(game, 1, { isBattle: true });

    const names: Partial<Record<BiomeId, string>> = {
      [BiomeId.SPACE]: "Space",
      [BiomeId.FAIRY_CAVE]: "Fairy Cave",
      [BiomeId.LABORATORY]: "Laboratory",
      [BiomeId.ISLAND]: "Island",
      [BiomeId.WASTELAND]: "Wasteland",
      [BiomeId.DOJO]: "Dojo",
    };
    console.log(`ORACLE-DIFF teleport claimed=${claimed} actual=${names[game.scene.arena.biomeId]}`);
    expect(names[game.scene.arena.biomeId]).toBe(claimed);
  });

  // The pay is a formula over the worker's stats, not a draw: the card names both the worker and the amount.
  it("Part-Timer: the pay the card names is the money the game pays", async () => {
    await arrive(game, caseFor(MysteryEncounterType.PART_TIMER));

    const card = readCard(game);
    const outcome: string = card.options[0].outcome;
    const worker = /^(\S+) earns \$([\d,]+)/.exec(outcome);
    expect(worker, `option 1 reads "${outcome}"`).toBeTruthy();
    const claimedPay = Number(worker![2].replaceAll(",", ""));
    const party = game.scene.getPlayerParty();
    const workerNo = party.findIndex(p => p.name === worker![1]) + 1;
    expect(workerNo, `the card's worker ${worker![1]} is in the party`).toBeGreaterThan(0);

    const before = game.scene.money;
    await pickOption(game, 1, { pokemonNo: workerNo });

    console.log(`ORACLE-DIFF part-timer claimed=${claimedPay} actual=${game.scene.money - before}`);
    expect(game.scene.money - before).toBe(claimedPay);
  });

  // The chest's roll is the pre-option fork's only draw (×1), and which branch it picks is the very thing under test,
  // so this reads the roll the game stored and follows the game's branch rather than the card's guess at it.
  // `TRAP_PERCENT` in `mysterious-chest-encounter.ts`; the prize phrasings are `46-encounter.js`'s.
  const TRAP_PERCENT = 30;
  const CHEST_PRIZES: Record<string, ModifierTier[]> = {
    "pick of 2 Common + 2 Great items": [
      ModifierTier.COMMON,
      ModifierTier.COMMON,
      ModifierTier.GREAT,
      ModifierTier.GREAT,
    ],
    "pick of 3 Ultra items": [ModifierTier.ULTRA, ModifierTier.ULTRA, ModifierTier.ULTRA],
    "pick of 2 Rogue items": [ModifierTier.ROGUE, ModifierTier.ROGUE],
    "a Master item": [ModifierTier.MASTER],
  };

  // The harness's run seed is fixed, so a wave picks the roll: 45 opens a chest, 65 springs the trap. Both branches
  // of the card's claim are walked rather than whichever one this seed happens to land on. That mapping is pinned
  // below, so a seed that stops walking both goes red here rather than quietly checking one branch twice; at a pin
  // bump, re-pick the waves rather than dropping the assertion.
  it.each([45, 65])("Mysterious Chest at wave %i: the chest the card names is the chest the game opens", async wave => {
    await arrive(game, { ...caseFor(MysteryEncounterType.MYSTERIOUS_CHEST), wave });

    const card = readCard(game);
    const claimed: string = card.options[0].outcome;
    expect(card.options[0].exact, "the card claims an exact chest").toBe(true);

    await chooseOption(game, 1);
    const roll: number = game.scene.currentBattle.mysteryEncounter!.misc.roll;
    const trapped = roll < TRAP_PERCENT;
    expect(trapped, `wave ${wave} rolled ${roll}; the fixed seed no longer walks both branches`).toBe(wave === 65);
    // Whoever the trap would take, named while they are still standing.
    const victim = game.scene
      .getPlayerParty()
      .filter(p => p.isAllowedInBattle())
      .reduce((t, p) => (p.level > t.level ? p : t));

    await runOptionOut(game, { isBattle: trapped });

    if (trapped) {
      console.log(`ORACLE-DIFF chest roll=${roll} claimed="${claimed}" actual=trap on ${victim.name}`);
      expect(claimed).toBe(`trap: ${victim.name} faints, then a Gimmighoul boss fight`);
      expect(victim.isFainted(), `${victim.name} survived the trap`).toBe(true);
      expect(game.scene.getEnemyParty()[0].species.speciesId).toBe(SpeciesId.GIMMIGHOUL);
      return;
    }

    await game.phaseInterceptor.to("SelectModifierPhase");
    const tiers = rewardOptions(game).map(t => t.tier);
    const asNames = (ts: ModifierTier[]) => [...ts].sort().map(t => ModifierTier[t]);
    console.log(`ORACLE-DIFF chest roll=${roll} claimed="${claimed}" actual=[${asNames(tiers)}]`);
    expect(CHEST_PRIZES[claimed], `the card reads "${claimed}", which is no prize the chest gives`).toBeTruthy();
    expect(asNames(tiers)).toEqual(asNames(CHEST_PRIZES[claimed]));
  });

  /** The card's own phrasing for a tally of roll outcomes (`46-encounter.js`'s `count`). */
  const tally = (counts: number[], names: [string, string?][]) =>
    names
      .map(([one, many], k) => [counts[k], one, many ?? one] as const)
      .filter(([n]) => n > 0)
      .map(([n, one, many]) => `${n} ${n === 1 ? one : many}`)
      .join(", ");

  /** Per store option: the card's phrasing, and the substring the game's modifier id carries for each roll value. */
  const STORE_OPTIONS: { no: number; prefix: string; names: [string, string?][]; keys: string[] }[] = [
    { no: 1, prefix: "pick of 5 TMs", names: [["Common"], ["Great"], ["Ultra"]], keys: ["TM_COMMON", "TM_GREAT", "TM_ULTRA"] },
    { no: 2, prefix: "pick of 3", names: [["vitamin", "vitamins"], ["PP Up", "PP Ups"]], keys: ["BASE_STAT_BOOSTER", "PP_UP"] },
    { no: 3, prefix: "pick of 5", names: [["X item", "X items"], ["Dire Hit", "Dire Hits"]], keys: ["TEMP_STAT_STAGE_BOOSTER", "DIRE_HIT"] },
    { no: 4, prefix: "pick of 4 ball packs", names: [["Poké"], ["Great"], ["Ultra"], ["Rogue"]], keys: ["POKEBALL", "GREAT_BALL", "ULTRA_BALL", "ROGUE_BALL"] },
  ];

  // Every store option's closure runs in the same option fork (×500), so the card reads all four from one offset and
  // the game runs whichever one is picked from that same offset: one run per option, each checked against its shop.
  it.each(STORE_OPTIONS)(
    "Department Store Sale option $no: the items the card names are the items the game offers",
    async store => {
      await arrive(game, caseFor(MysteryEncounterType.DEPARTMENT_STORE_SALE));

      const card = readCard(game);
      const claimed: string = card.options[store.no - 1].outcome;
      expect(card.options[store.no - 1].exact, "the card claims exact store rolls").toBe(true);

      await pickOption(game, store.no);
      await game.phaseInterceptor.to("SelectModifierPhase");

      const ids: string[] = rewardOptions(game).map(t => t.id);
      const counts = store.keys.map(key => ids.filter(id => id.includes(key)).length);
      const actual = `${store.prefix}: ${tally(counts, store.names)}`;
      console.log(`ORACLE-DIFF store-${store.no} claimed="${claimed}" actual="${actual}" ids=[${ids}]`);
      expect(counts.reduce((a, b) => a + b, 0), `every offer is one of ${store.keys}, got [${ids}]`).toBe(ids.length);
      expect(actual).toBe(claimed);
    },
  );

  // Who the heat burns is the option fork's first draw (×500), over the non-Fire mons that can still take a status.
  it("Fiery Fallout: the mon the card says the heat burns is the mon the game burns", async () => {
    await arrive(game, caseFor(MysteryEncounterType.FIERY_FALLOUT));

    const card = readCard(game);
    const claimed: string = card.options[1].outcome;
    expect(card.options[1].exact, "the card claims an exact victim").toBe(true);
    const named = /; (.+?) (is burned and its ability becomes Heatproof for good|shrugs off the burn)$/.exec(claimed);
    expect(named, `option 2 reads "${claimed}"`).toBeTruthy();
    const [, who, what] = named!;

    await pickOption(game, 2);

    const burned = game.scene.getPlayerParty().filter(p => p.status?.effect === StatusEffect.BURN);
    console.log(`ORACLE-DIFF fallout claimed="${who} ${what}" actual=[${burned.map(p => p.name)}]`);
    if (what === "shrugs off the burn") {
      // A shrugged burn leaves nothing behind on the mon, so this branch can only check that nobody was burned:
      // the card could name the wrong shrugger and still pass. Inherent, not an omission.
      expect(burned.map(p => p.name)).toEqual([]);
      return;
    }
    expect(burned.map(p => p.name)).toEqual([who]);
    expect(burned[0].getAbility().id).toBe(AbilityId.HEATPROOF);
  });

  // The new nature is the post-option fork's draw (×2000), on the mon the card says the cheap deal would take.
  it("Shady Vitamin Dealer: the nature the card names is the nature the game rolls", async () => {
    await arrive(game, caseFor(MysteryEncounterType.SHADY_VITAMIN_DEALER));

    const card = readCard(game);
    const claimed: string = card.options[0].outcome;
    expect(card.options[0].exact, "the card claims an exact nature").toBe(true);
    const named = /— (.+?) becomes ([A-Za-z]+) [(]/.exec(claimed);
    expect(named, `option 1 reads "${claimed}"`).toBeTruthy();
    const [, who, nature] = named!;

    const party = game.scene.getPlayerParty();
    const carryNo = party.findIndex(p => p.name === who) + 1;
    expect(carryNo, `the card's ${who} is in the party`).toBeGreaterThan(0);
    const mon = party[carryNo - 1];
    const before = mon.nature;

    await pickOption(game, 1, { pokemonNo: carryNo });
    // The post-option phase sits past the shop the encounter leaves behind, so that has to be dismissed first, the
    // way upstream's own post-phase tests do it.
    await game.phaseInterceptor.to("SelectModifierPhase");
    game.endPhase();
    await game.phaseInterceptor.to("PostMysteryEncounterPhase");

    // `setCustomNature` writes `customPokemonData`, so the new nature is the one `getNature` reads, not the raw field.
    const after = mon.getNature();
    console.log(`ORACLE-DIFF vitamins ${who} claimed=${nature} actual=${Nature[after]} was=${Nature[before]}`);
    expect(Nature[after]).toBe(nature.toUpperCase());
    expect(after, "the dealer never rolls the nature it already had").not.toBe(before);
  });

  // The tutor's four moves are the option fork's first four draws (×500), one from each pool, and they are rolled
  // before the fight starts — so the card can name them while the player is still choosing whether to fight at all.
  it("Bug-Type Superfan: the tutor moves the card names are the moves the game rolled", async () => {
    await arrive(game, caseFor(MysteryEncounterType.BUG_TYPE_SUPERFAN));

    const card = readCard(game);
    const claimed: string = card.options[0].outcome;
    expect(card.options[0].exact, "the card claims exact tutor moves").toBe(true);
    const named = /a free tutor move: (.+)$/.exec(claimed);
    expect(named, `option 1 reads "${claimed}"`).toBeTruthy();
    const claimedMoves = named![1].split(/, | & /);
    expect(claimedMoves).toHaveLength(4);

    await pickOption(game, 1, { isBattle: true });

    const rolled: string[] = game.scene.currentBattle.mysteryEncounter!.misc.moveTutorOptions.map((m: PokemonMove) =>
      m.getName(),
    );
    console.log(`ORACLE-DIFF superfan claimed=[${claimedMoves}] actual=[${rolled}]`);
    expect(claimedMoves).toEqual(rolled);
  });

  // How many berries begging gets back is arithmetic over what the Greedent took, two fifths of each holder's own.
  it("Absolute Avarice: the berries the card says come back are the berries the game returns", async () => {
    await arrive(game, caseFor(MysteryEncounterType.ABSOLUTE_AVARICE));

    const card = readCard(game);
    const claimed: string = card.options[1].outcome;
    expect(card.options[1].exact, "the card claims an exact count").toBe(true);
    const named = /^beg: (\d+) berr(?:y|ies) of your (\d+) come back/.exec(claimed);
    expect(named, `option 2 reads "${claimed}"`).toBeTruthy();
    const [, back, stolen] = named!.map(Number);

    // The encounter takes the berries as its visuals start, so by the option screen the player holds none.
    const count = () =>
      game.scene.findModifiers(m => m instanceof BerryModifier).reduce((t, m) => t + m.getStackCount(), 0);
    expect(count(), "the Greedent has already taken them").toBe(0);

    await pickOption(game, 2);

    console.log(`ORACLE-DIFF avarice stolen=${stolen} claimed=${back} actual=${count()}`);
    expect(count()).toBe(back);
  });

  // ---- Ultra and rogue tier
  //
  // Several of these encounters fight the party and one transforms it, so what the oracle asserts needs saying once.
  // The claim under test is the card as the option screen shows it, and a claim is walked past that screen only when
  // doing so is what settles it:
  //
  // - Dark Deal's victim and Clowning Around's type shuffle are both written by a *pre*-option phase, so a single
  //   `chooseOption` reads them with the option itself never run out. Dark Deal's starter tier is the exception on
  //   its own card: the fork rolls it and only the boss it produced can be read back, so that one option is run out.
  // - Weird Dream's swap is checked by running its non-battle option out, because the party afterwards *is* the claim.
  // - A Trainer's Test is run out too, and for the opposite reason to the rest: its config carries no
  //   `pokemonConfigs`, so the card's count comes off a party template the game need not use, and only the party it
  //   fields settles whether that count was right.
  // - The remaining fights — The Winstrate Challenge, the breeder's, Trash to Treasure's — are never run: what the
  //   card claims about them it reads off `enemyPartyConfigs` and `misc` before a button is pressed, and that state
  //   is what the battle is built from. Those are checked against it directly.

  // The victim is `getRandomPlayerPokemon(true, false, true)`, drawn in the pre-option phase, which also writes the
  // name it took into the `pokeName` dialogue token — so the game names its own victim and the card's guess at it is
  // checked against that, not against a re-derivation. The whole take/avoid call hangs on this name.
  it("Dark Deal: the mon the card says is taken is the mon the game takes", async () => {
    await arrive(game, caseFor(MysteryEncounterType.DARK_DEAL));

    const card = readCard(game);
    const claimed: string = card.options[0].outcome;
    expect(card.options[0].exact, "the card claims an exact victim and tier").toBe(true);
    const named = /^(.+?) is taken for good → .*starter tier ([\d–]+)/.exec(claimed);
    expect(named, `option 1 reads "${claimed}"`).toBeTruthy();
    const [, who, tier] = named!;
    const before = game.scene.getPlayerParty().map(p => p.name);
    expect(before, `the card's ${who} is in the party`).toContain(who);

    await chooseOption(game, 1);

    const me = game.scene.currentBattle.mysteryEncounter!;
    const taken = me.dialogueTokens.pokeName;
    const after = game.scene.getPlayerParty().map(p => p.name);
    console.log(`ORACLE-DIFF dark-deal claimed=${who} actual=${taken} party=${before} → ${after}`);
    expect(taken).toBe(who);
    expect(after, `${who} is gone from the party`).not.toContain(who);

    // The tier is the option fork's own draw, and only the boss it produced can be read back. `getRandomSpeciesByStarterCost`
    // widens its band when no starter of the victim's types sits in it, so the cost is the claim only while the band
    // was actually servable — which is checked here rather than assumed, off the game's own registry.
    await runOptionOut(game, { isBattle: true });
    const boss = game.scene.getEnemyParty()[0];
    const cost = speciesDataRegistry.getStarterCost(boss.species.speciesId);
    const [min, max = min] = tier.split("–").map(Number);
    expect(Number.isFinite(min) && Number.isFinite(max), `the card's tier "${tier}" reads as a band`).toBe(true);
    const types: number[] = me.misc.removedTypes;
    const servable = speciesDataRegistry
      .getAllStarters(true)
      .filter(s => s && (types.includes(s.type1) || (s.type2 != null && types.includes(s.type2))))
      .some(s => {
        const c = speciesDataRegistry.getStarterCost(s.speciesId);
        return c >= min && c <= max;
      });
    console.log(`ORACLE-DIFF dark-deal-tier claimed=${tier} boss=${boss.species.name} cost=${cost} servable=${servable}`);
    // The pinned seed lands on a band the registry can serve, so that is pinned too rather than left as a guard: a
    // pin bump that makes the game widen instead goes red here — "re-read this" — instead of quietly asserting
    // nothing. `servable` reads types only, where the game also drops its excluded bosses, so it is the wider test of
    // the two: if it ever goes false the band really was unservable, and the cost below is not the claim to check.
    expect(servable, `starter tier ${tier} has a starter of types ${types} to draw from`).toBe(true);
    expect(cost, `the card claimed tier ${tier}; ${boss.species.name} costs ${cost}`).toBeGreaterThanOrEqual(min);
    expect(cost).toBeLessThanOrEqual(max);
  });

  // Every member's second type is redrawn in the pre-option phase, onto `customPokemonData.types`. The card replays
  // that draw — the priority pool, the game's own default (string) `.sort()` over type *numbers*, `randSeedShuffle`,
  // then a plain roll when the pool runs dry — so this walks the card's whole named list against what the game wrote.
  it("Clowning Around: the types the card names are the types the game writes", async () => {
    await arrive(game, caseFor(MysteryEncounterType.CLOWNING_AROUND));

    const card = readCard(game);
    const claimed: string = card.options[2].outcome;
    expect(card.options[2].exact, "the card claims an exact shuffle").toBe(true);
    const listed = /every member's 2nd type is redrawn: (.+)$/.exec(claimed);
    expect(listed, `option 3 reads "${claimed}"`).toBeTruthy();
    const pairs = listed![1].split(", ").map(p => p.split(" → ") as [string, string]);

    // The clown's own ability and Blacephalon's rolled types are `onInit` reads the other two options lean on, and
    // both are on the screen already: checked here rather than given a case of their own.
    const me = game.scene.currentBattle.mysteryEncounter!;
    expect(card.options[0].outcome).toContain(me.dialogueTokens.ability);
    const blace: number[] = me.enemyPartyConfigs[0].pokemonConfigs[1].customPokemonData.types;
    expect(card.options[0].outcome).toContain(blace.map(t => typeName(t)).join(" / "));

    await chooseOption(game, 3);

    const actual = game.scene.getPlayerParty().map(p => [p.name, typeName(p.customPokemonData.types![1])]);
    console.log(`ORACLE-DIFF clown claimed=${JSON.stringify(pairs)} actual=${JSON.stringify(actual)}`);
    expect(actual).toEqual(pairs);
  });

  // The price is `misc.price`, not the option's `cost` — that is the money *requirement*'s ceiling (2× wave money)
  // and runs to twice the real price, so a card reading the wrong one would be confidently wrong about every sale.
  it("The Pokémon Salesman: the price the card names is the money the game takes", async () => {
    await arrive(game, caseFor(MysteryEncounterType.THE_POKEMON_SALESMAN));

    const card = readCard(game);
    const outcome: string = card.options[0].outcome;
    const sale = /^\$([\d,]+): (.+?) joins at L5$/.exec(outcome);
    expect(sale, `option 1 reads "${outcome}"`).toBeTruthy();
    const claimedPrice = Number(sale![1].replaceAll(",", ""));
    const claimedName = sale![2].replace(/ \(hidden ability\)| ★shiny/g, "");

    const before = game.scene.money;
    const partyBefore = game.scene.getPlayerParty().length;
    await pickOption(game, 1);

    const bought = game.scene.getPlayerParty().at(-1)!;
    console.log(`ORACLE-DIFF salesman claimed=${claimedPrice}/${claimedName} actual=${before - game.scene.money}/${bought.name} L${bought.level}`);
    expect(before - game.scene.money).toBe(claimedPrice);
    expect(game.scene.getPlayerParty()).toHaveLength(partyBefore + 1);
    expect(bought.name).toBe(claimedName);
    expect(bought.level).toBe(5);
  });

  // `onInit` puts up the party's three least-friendly members with an egg count each, and the card's three rows are a
  // read of that `misc`. Only the picked one fights, so this is checked on the screen rather than run out.
  it("The Expert Pokémon Breeder: the three on offer and their eggs are the ones the game set up", async () => {
    await arrive(game, caseFor(MysteryEncounterType.THE_EXPERT_POKEMON_BREEDER));

    const card = readCard(game);
    const me = game.scene.currentBattle.mysteryEncounter!;
    for (const k of [0, 1, 2]) {
      const mon = me.misc[`pokemon${k + 1}`];
      const common: number = me.misc[`pokemon${k + 1}CommonEggs`] ?? 0;
      const rare: number = me.misc[`pokemon${k + 1}RareEggs`] ?? 0;
      const outcome: string = card.options[k].outcome;
      console.log(`ORACLE-DIFF breeder-${k + 1} mon=${mon.name} rare=${rare} common=${common} outcome="${outcome}"`);
      expect(outcome).toMatch(new RegExp(`^${mon.name} fights the breeder's \\d+ alone`));
      // The card writes a Great egg for what `misc` calls a rare one, and drops a count of zero rather than print it.
      expect(outcome).toContain(rare ? `${rare} Great egg${rare === 1 ? "" : "s"}` : "Soothe Bell");
      if (common) {
        expect(outcome).toContain(`${common} Common egg${common === 1 ? "" : "s"}`);
      }
    }
    // The breeder is the trainer fight that *does* set `pokemonConfigs` — it builds the three mons itself — so its
    // size comes from that length and its `trainerConfig` carries no `partyTemplates` at all. The card takes the
    // configs first and the template only as a fallback, which is what makes it right here.
    const cfg = me.enemyPartyConfigs[0];
    expect(cfg.trainerConfig?.partyTemplates, "the breeder sets its party outright, not from a template").toBeUndefined();
    expect(card.options[0].outcome).toContain(`fights the breeder's ${cfg.pokemonConfigs.length} alone`);
  });

  // `onInit` has rolled the whole swap before the screen opens, so the card names every species it will become. This
  // is the one transforming option cheap enough to run out: the party afterwards is exactly the claim.
  it("Weird Dream: the party the card names is the party the game swaps in", async () => {
    await arrive(game, caseFor(MysteryEncounterType.WEIRD_DREAM));

    const card = readCard(game);
    const outcome: string = card.options[0].outcome;
    const listed = /your whole party is swapped: (.+?) — same levels/.exec(outcome);
    expect(listed, `option 1 reads "${outcome}"`).toBeTruthy();
    const pairs = listed![1].split(", ").map(p => /^(.+?) → (.+?) \([+−]\d+\)$/.exec(p)!).map(m => [m[1], m[2]]);

    const me = game.scene.currentBattle.mysteryEncounter!;
    const rolled = me.misc.teamTransformations.map((t: { previousPokemon: { name: string }; newSpecies: { name: string } }) => [
      t.previousPokemon.name,
      t.newSpecies.name,
    ]);
    expect(pairs).toEqual(rolled);

    await pickOption(game, 1);

    const after = game.scene.getPlayerParty().map(p => p.species.name);
    console.log(`ORACLE-DIFF weird-dream claimed=${JSON.stringify(pairs)} actual=${JSON.stringify(after)}`);
    expect(after).toEqual(pairs.map(([, to]) => to));
  });

  // A Trainer's Test is the one trainer fight whose config carries no `pokemonConfigs` at all, so the card's count
  // falls through to `trainerConfig.partyTemplates[0].size` — and `46-encounter.js` warns in its own comment that
  // `Trainer.getPartyTemplate` need not pick template 0. Reading that same field back would assert the card's rule
  // against itself, so the fight is run and the count checked against the party the game actually fields.
  it("A Trainer's Test: the party size the card names is the party the game fields", async () => {
    await arrive(game, caseFor(MysteryEncounterType.A_TRAINERS_TEST));

    const card = readCard(game);
    const outcome: string = card.options[0].outcome;
    const named = /^fight (.+?): (\d+) mons/.exec(outcome);
    expect(named, `option 1 reads "${outcome}"`).toBeTruthy();
    const [, who, claimed] = named!;

    const cfgs = game.scene.currentBattle.mysteryEncounter!.enemyPartyConfigs;
    expect(cfgs, "the encounter sets up one trainer").toHaveLength(1);
    expect(who).toBe(cfgs[0].trainerConfig.name);

    await pickOption(game, 1, { isBattle: true });

    const fielded = game.scene.getEnemyParty().length;
    console.log(`ORACLE-DIFF A_TRAINERS_TEST outcome="${outcome}" claimed=${claimed} fielded=${fielded}`);
    expect(Number(claimed)).toBe(fielded);
  });

  // The Winstrate Challenge sets `pokemonConfigs` on every one of its five configs, so the size the card reads is the
  // party each battle is built from rather than a template it might not use. Running five fights out would settle
  // nothing that state does not already carry, so this is checked at the screen.
  it("The Winstrate Challenge: the battles and total the card names are the ones the encounter set up", async () => {
    await arrive(game, caseFor(MysteryEncounterType.THE_WINSTRATE_CHALLENGE));

    const card = readCard(game);
    const outcome: string = card.options[0].outcome;
    const named = /^(\d+) trainer battles back to back, (\d+) mons in all/.exec(outcome);
    expect(named, `option 1 reads "${outcome}"`).toBeTruthy();

    const cfgs = game.scene.currentBattle.mysteryEncounter!.enemyPartyConfigs;
    const mons = cfgs.reduce((n: number, cfg) => n + (cfg.pokemonConfigs?.length ?? 0), 0);
    console.log(`ORACLE-DIFF THE_WINSTRATE_CHALLENGE outcome="${outcome}" configs=${cfgs.length} mons=${mons}`);

    expect(cfgs.every(cfg => cfg.pokemonConfigs?.length), "every Winstrate battle brings its own party").toBeTruthy();
    expect(Number(named![1])).toBe(cfgs.length);
    expect(Number(named![2])).toBe(mons);
  });
});

