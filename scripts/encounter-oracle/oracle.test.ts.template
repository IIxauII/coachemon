/** The case for one encounter, so an outcome check arrives exactly where the structural pass did. */
const caseFor = (type: MysteryEncounterType): Case => {
  const found = CASES.find(c => c.type === type);
  if (!found) {
    throw new Error(`no case for encounter type ${type}`);
  }
  return found;
};

